<%# Exercised by the "Turbo Frame navigation" system spec. Uses layouts/turbo_frame, which loads
    @hotwired/turbo instead of the Turbolinks that the main layout runs. %>
<h1>Turbo Frame navigation</h1>

<%# Lives outside the frame, so a frame navigation must leave it mounted. %>
<%= react_component("TurboFrameProbe",
                    props: { label: "Outside frame island", testId: "outside-frame" },
                    prerender: false,
                    auto_load_bundle: false,
                    id: "outside-frame") %>

<%# ?case= picks the frame scenario; every frame link keeps it. Without it, the two steps use
    different DOM ids. "same-id" reuses one DOM id across both steps. "waiting-store" makes the
    first frame component wait on a store whose data never arrives, then replaces it with same-id
    content that brings the store. %>
<% frame_case = params[:case].presence_in(%w[same-id waiting-store]) %>
<% next_frame_path = turbo_frame_navigation_path(step: 2, case: frame_case) %>
<turbo-frame id="react-frame">
  <% if frame_case == "same-id" %>
    <% second = params[:step] == "2" %>
    <%= react_component("TurboFrameProbe",
                        props: { label: second ? "Second same-id island" : "First same-id island",
                                 testId: second ? "same-id-second" : "same-id-first" },
                        prerender: false,
                        auto_load_bundle: false,
                        id: "frame-shared") %>
    <%= link_to "Load next frame", next_frame_path unless second %>
  <% elsif frame_case == "waiting-store" %>
    <% if params[:step] == "2" %>
      <%= redux_store("TurboFrameStore", props: { source: "second" }) %>
      <%= react_component("TurboFrameProbe",
                          props: { label: "Second waiting island", testId: "waiting-second" },
                          prerender: false,
                          auto_load_bundle: false,
                          store_dependencies: ["TurboFrameStore"],
                          id: "frame-waiting") %>
    <% else %>
      <%# Deferred, and this layout renders no redux_store_hydration_data, so the data never arrives. %>
      <% redux_store("TurboFrameStore", props: { source: "first" }, defer: true) %>
      <%= react_component("TurboFrameProbe",
                          props: { label: "First waiting island", testId: "waiting-first" },
                          prerender: false,
                          auto_load_bundle: false,
                          store_dependencies: ["TurboFrameStore"],
                          id: "frame-waiting") %>
      <%= link_to "Load next frame", next_frame_path %>
    <% end %>
  <% elsif params[:step] == "2" %>
    <%= react_component("TurboFrameProbe",
                        props: { label: "Second frame island", testId: "frame-second" },
                        prerender: false,
                        auto_load_bundle: false,
                        id: "frame-second") %>
  <% else %>
    <%= react_component("TurboFrameProbe",
                        props: { label: "First frame island", testId: "frame-first" },
                        prerender: false,
                        auto_load_bundle: false,
                        id: "frame-first") %>
    <%= link_to "Load next frame", next_frame_path %>
  <% end %>
</turbo-frame>
