<%# Exercised by the "Turbo Frame navigation" system spec. Uses layouts/turbo_frame, which loads
    @hotwired/turbo instead of the Turbolinks that the main layout runs. %>
<h1>Turbo Frame navigation</h1>

<%# Lives outside the frame, so a frame navigation must leave it mounted. %>
<%= react_component("TurboFrameProbe",
                    props: { label: "Outside frame island", testId: "outside-frame" },
                    prerender: false,
                    auto_load_bundle: false,
                    id: "outside-frame") %>

<turbo-frame id="react-frame">
  <% if params[:step] == "2" %>
    <%= react_component("TurboFrameProbe",
                        props: { label: "Second frame island", testId: "frame-second" },
                        prerender: false,
                        auto_load_bundle: false,
                        id: "frame-second") %>
  <% else %>
    <%= react_component("TurboFrameProbe",
                        props: { label: "First frame island", testId: "frame-first" },
                        prerender: false,
                        auto_load_bundle: false,
                        id: "frame-first") %>
    <%= link_to "Load next frame", turbo_frame_navigation_path(step: 2) %>
  <% end %>
</turbo-frame>
