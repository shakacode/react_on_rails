<%# Probe page for the stale hydrated-store regression after a Turbolinks/Turbo soft
    navigation (issue #4861). Exercised by e2e-tests/stale_store_after_navigation.spec.ts.

    Two variants of this page (?variant=one|two) declare a DEFERRED SharedReduxStore whose
    props embed the variant, so the store's hydration data lands at the END of the layout
    body (redux_store_hydration_data) while the components appear mid-page. Soft-navigating
    between the variants gives each page a predecessor whose store data differs from its own.

    The inline probe script below calls ReactOnRails.getOrWaitForStore at the same point in
    the page lifecycle where a component's store_dependencies hydration gate calls it (an
    inline script executing during body parse/activation, before the deferred hydration data)
    and records which page's store the promise delivers. If the previous page's store entry
    survives the navigation, the promise resolves immediately with the PREVIOUS page's store
    instead of waiting for this page's own hydration data. %>
<% content_for(:head) do %>
  <meta name="turbolinks-cache-control" content="no-cache">
<% end %>

<% redux_store("SharedReduxStore", props: @stale_store_probe_props, defer: true) %>

<h1 id="probe-variant" data-variant="<%= @variant %>">Stale store probe — variant <%= @variant %></h1>

<p>
  This page's SharedReduxStore is deferred: its hydration data renders at the end of the
  layout body. Components above it must wait for it before rendering.
</p>

<div id="stale-store-probe-result" data-variant="<%= @variant %>">Waiting for store...</div>

<script>
  // Mirrors the store_dependencies hydration gate: an inline script calling
  // getOrWaitForStore during body parse (first load) / body activation (Turbolinks render),
  // BEFORE the deferred store hydration data at the end of the layout body has executed.
  // On a correct implementation this must wait for THIS page's store. The poll loop only
  // matters on first load, where the async client bundle may not have executed yet; on a
  // soft navigation the bundle is already loaded and the probe runs synchronously.
  (function staleStoreProbe() {
    function attempt() {
      if (typeof ReactOnRails !== 'object' || typeof ReactOnRails.getOrWaitForStore !== 'function') {
        setTimeout(attempt, 10);
        return;
      }

      var resultNode = document.getElementById('stale-store-probe-result');

      // Diagnostic only (not asserted): the store registry content at probe time.
      var syncStore = ReactOnRails.getStore('SharedReduxStore', false);
      resultNode.setAttribute(
        'data-sync-name',
        syncStore ? syncStore.getState().helloWorldData.name : 'none'
      );

      ReactOnRails.getOrWaitForStore('SharedReduxStore')
        .then(function (store) {
          var name = store.getState().helloWorldData.name;
          resultNode.setAttribute('data-resolved-name', name);
          resultNode.textContent = 'Store delivered by getOrWaitForStore: ' + name;
        })
        .catch(function () {
          // Page-unload cancellation (navigated away while waiting) — nothing to record.
        });
    }

    attempt();
  })();
</script>

<%= react_component("ReduxSharedStoreApp", prerender: false, trace: true, id: "ReduxSharedStoreApp-react-component-probe") %>

<hr/>

<% other_variant = @variant == "one" ? "two" : "one" %>
<a id="probe-link-other-variant" href="<%= stale_store_probe_path(variant: other_variant, enableTurbolinks: true) %>">
  Soft-navigate to variant <%= other_variant %>
</a>
