<% content_for :head do %>
  <style>
    /* The dummy's fixed-width menu would otherwise hide these forms on phones. */
    @media (max-width: 640px) {
      .app-shell > .app-sidebar { display: none; }
    }
  </style>
<% end %>
<h1>Form libraries on RSC pages</h1>
<nav aria-label="Form library examples">
  <ul>
    <li><%= link_to "React 19 built-ins", rsc_forms_builtins_path %></li>
    <li><%= link_to "Conform", rsc_forms_conform_path %></li>
    <li><%= link_to "React Hook Form + zod", rsc_forms_rhf_path %></li>
    <li><%= link_to "TanStack Form", rsc_forms_tanstack_path %></li>
  </ul>
</nav>
<p>
  Rails validates each review. Try the name Reserved to see a server validation error.
  Only your latest review is kept in this browser session.
</p>
<%= stream_react_component(@form_component, props: @form_props, id: "rsc-forms-example") %>
