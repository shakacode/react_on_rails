#!/usr/bin/env bash
# Check links in changed Markdown files with lychee.
# Pre-push (branch context, online) checks local links in full and fetches only
# remote URLs new since the merge base; see below.
set -euo pipefail
source "$(dirname "$0")/ensure-mise"

CONTEXT="${1:-staged}"
MODE="${2:-}"
files="$(bin/lefthook/get-changed-files "$CONTEXT" '\.md$')"

if [ -z "$files" ]; then
  echo "✅ No Markdown files to check with lychee"
  exit 0
fi

lychee_args=(--config .lychee.toml)
if [ "$MODE" = "--offline" ]; then
  lychee_args+=(--offline)
  mode_label="offline"
else
  mode_label="online"
fi

if ! command -v lychee &> /dev/null; then
  echo "⚠️  lychee is not installed; skipping ${mode_label} Markdown link check." >&2
  echo "   Install with: brew install lychee  # macOS" >&2
  echo "                 cargo install lychee # cross-platform" >&2
  echo "   Or run bin/check-links manually before pushing." >&2
  exit 0
fi

required_lychee_version="0.23.0"
lychee_version="$(lychee --version 2>&1 || true)"
if [ "$lychee_version" != "lychee ${required_lychee_version}" ]; then
  echo "⚠️  lychee version mismatch; skipping ${mode_label} Markdown link check." >&2
  echo "   Found: ${lychee_version:-unable to determine}" >&2
  echo "   Required: lychee ${required_lychee_version} (matches CI)" >&2
  echo "   Install with: cargo install lychee --version ${required_lychee_version}" >&2
  echo "   Or run bin/check-links manually with lychee ${required_lychee_version}." >&2
  exit 0
fi

files_arr=()
while IFS= read -r file; do
  [ -n "$file" ] && files_arr+=("$file")
done <<< "$files"

if [ "$CONTEXT" != "branch" ] || [ "$MODE" = "--offline" ]; then
  echo "🔗 Lychee (${mode_label}) on $CONTEXT Markdown files:"
  printf "  %s\n" "${files_arr[@]}"

  lychee "${lychee_args[@]}" "${files_arr[@]}"

  echo "✅ Markdown link checks passed"
  exit 0
fi

# Pre-push (branch context, online). Checking every link in each changed file
# re-fetched ~400 untouched CHANGELOG.md URLs on every push, and GitHub
# throttling stretched that to 10+ minutes. Instead:
#   1. Check every local link in the changed files offline. This covers relative
#      links and this repository's blob/tree main links, which
#      bin/lychee-self-repo-links turns into file:// URLs.
#   2. Fetch only the remote URLs that are new in each file since the merge base.
# CI's check-markdown-links workflow still checks every link.
echo "🔗 Lychee (offline) on all local links in branch Markdown files:"
printf "  %s\n" "${files_arr[@]}"
lychee --config .lychee.toml --offline "${files_arr[@]}"

repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=script/lib/git-diff-base
source "$repo_root/script/lib/git-diff-base"
base="$(git_diff_base_normalize_base_ref "${BASE_REF:-}")"
if ! merge_base="$(git_diff_base_resolve "$base" HEAD lenient)"; then
  exit 1
fi

# Keep scratch files under the ignored tmp/ directory and pass lychee relative
# paths, so exclude_path patterns see the original file's relative path and not
# the system temporary directory's.
mkdir -p tmp
tmpdir="$(mktemp -d tmp/markdown-link-lint.XXXXXX)"
trap 'rm -rf "$tmpdir"' EXIT

# Print the remote URLs lychee would check in a Markdown file, after the
# config's preprocess, remap, and exclude rules.
remote_urls() {
  lychee --config .lychee.toml --dump "$1" | { grep -E '^https?://' || true; } | LC_ALL=C sort -u
}

new_link_files=()
for file in "${files_arr[@]}"; do
  base_urls="$tmpdir/base-urls"
  : > "$base_urls"
  # A file added or renamed on this branch has no base version, so all its
  # remote URLs are new.
  if [ "$(git cat-file -t "$merge_base:$file" 2>/dev/null || true)" = "blob" ]; then
    base_copy="$tmpdir/base/$file"
    mkdir -p "$(dirname "$base_copy")"
    git show "$merge_base:$file" > "$base_copy"
    remote_urls "$base_copy" > "$base_urls"
  fi

  new_urls="$tmpdir/new-urls"
  remote_urls "$file" | LC_ALL=C comm -13 "$base_urls" - > "$new_urls"
  if [ -s "$new_urls" ]; then
    echo "🔗 New remote links in $file:"
    sed 's/^/  /' "$new_urls"
    # Hand the URLs to lychee as HTML anchors: re-reading them as plain text
    # or Markdown autolinks drops trailing punctuation such as "," or ".".
    new_links="$tmpdir/new/$file.new-links.html"
    mkdir -p "$(dirname "$new_links")"
    perl -ne 'chomp; s/&/&amp;/g; s/"/&quot;/g; s/</&lt;/g; s/>/&gt;/g; print qq{<a href="$_"></a>\n}' \
      "$new_urls" > "$new_links"
    new_link_files+=("$new_links")
  fi
done

if [ "${#new_link_files[@]}" -eq 0 ]; then
  echo "✅ Local links passed; no new remote links to check (bin/check-links checks them all)"
  exit 0
fi

echo "🔗 Lychee (online) on new remote links:"
lychee --config .lychee.toml "${new_link_files[@]}"

echo "✅ Markdown link checks passed"
