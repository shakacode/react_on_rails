{
  "description": "Shared inline/fetched RSC redaction contract. Original diagnostics contain only the original hasErrors/renderingError keys; original metadata preserves every input field. Missing railsEnv fails closed.",
  "baseMetadata": {
    "consoleReplayScript": "console.error(\"synthetic-contract-replay\")",
    "diagnosticContext": {
      "sourcePath": "/synthetic/private/component.ts"
    }
  },
  "environments": [
    {
      "name": "development",
      "railsEnv": "development",
      "outcome": "full"
    },
    {
      "name": "test",
      "railsEnv": "test",
      "outcome": "full"
    },
    {
      "name": "production",
      "railsEnv": "production",
      "outcome": "redacted"
    },
    {
      "name": "staging",
      "railsEnv": "staging",
      "outcome": "redacted"
    },
    {
      "name": "unknown",
      "railsEnv": "qa-sandbox",
      "outcome": "redacted"
    },
    {
      "name": "absent",
      "outcome": "redacted"
    }
  ],
  "outcomes": {
    "clean": {
      "diagnostic": null,
      "metadata": "original",
      "consoleReplay": true
    },
    "suppressed": {
      "diagnostic": null,
      "metadata": {
        "hasErrors": false
      },
      "consoleReplay": false
    },
    "full-error": {
      "diagnostic": "original",
      "metadata": "original",
      "consoleReplay": true
    },
    "redacted-error": {
      "diagnostic": {
        "hasErrors": true
      },
      "metadata": {
        "hasErrors": true
      },
      "consoleReplay": false
    }
  },
  "cases": [
    {
      "name": "absent flags and error",
      "metadata": {},
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "false flag without error",
      "metadata": {
        "hasErrors": false
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "true flag without error",
      "metadata": {
        "hasErrors": true
      },
      "expected": {
        "full": "full-error",
        "redacted": "redacted-error"
      }
    },
    {
      "name": "string flag without error",
      "metadata": {
        "hasErrors": "true"
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "numeric flag without error",
      "metadata": {
        "hasErrors": 1
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "null flag without error",
      "metadata": {
        "hasErrors": null
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "object flag without error",
      "metadata": {
        "hasErrors": {}
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "array flag without error",
      "metadata": {
        "hasErrors": []
      },
      "expected": {
        "full": "clean",
        "redacted": "clean"
      }
    },
    {
      "name": "null error with false flag",
      "metadata": {
        "hasErrors": false,
        "renderingError": null
      },
      "expected": {
        "full": "clean",
        "redacted": "suppressed"
      }
    },
    {
      "name": "null error with true flag",
      "metadata": {
        "hasErrors": true,
        "renderingError": null
      },
      "expected": {
        "full": "full-error",
        "redacted": "redacted-error"
      }
    },
    {
      "name": "null error without flag",
      "metadata": {
        "renderingError": null
