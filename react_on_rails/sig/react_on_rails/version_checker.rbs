module ReactOnRails
  class VersionChecker
    VERSION_PARTS_REGEX: Regexp

    attr_reader node_package_version: untyped

    def self.build: () -> VersionChecker
    def initialize: (untyped node_package_version) -> void
    def validate_version_and_package_compatibility!: () -> void

    class NodePackageVersion
      attr_reader package_json: untyped

      def self.build: () -> NodePackageVersion
      def self.package_json_path: () -> untyped
      def initialize: (untyped package_json) -> void
      def raw: () -> String?
      def resolution_diagnostic: () -> LockfileResolution::Diagnostic?
      def react_on_rails_package?: () -> bool
      def react_on_rails_pro_package?: () -> bool
      def package_name: () -> String
      def semver_wildcard?: () -> bool
      def special_version_string?: () -> bool
      def wildcard_or_x_range?: () -> untyped
      def range_operator?: () -> bool
      def range_syntax?: () -> bool
      def local_path_or_url?: () -> bool
      def workspace_protocol?: () -> bool
      def parts: () -> Array[String]?
    end
  end
end
