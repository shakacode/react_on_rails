#!/usr/bin/env bash
# Run tests (Ruby except generated examples; the rake task includes JS tests).
set -euo pipefail
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"
( cd react_on_rails && bundle exec rake run_rspec:all_but_examples )
