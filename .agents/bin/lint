#!/usr/bin/env bash
# Lint / format check. Fix with: (cd react_on_rails && bundle exec rake autofix)
set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
rc=0
( cd react_on_rails && bundle exec rake lint ) || rc=1
if [ -d react_on_rails_pro ]; then
  ( cd react_on_rails_pro && BUNDLE_GEMFILE=../Gemfile bundle exec rubocop --ignore-parent-exclusion ) || rc=1
fi
legacy_doctor_dir=.agents/fixtures/agent-workflows/bin
if [ ! -f "$legacy_doctor_dir/agent-workflow-seam-doctor" ] || \
  [ ! -f "$legacy_doctor_dir/agent-workflow-seam-doctor-test.rb" ]; then
  echo "legacy agent-workflows fixture is incomplete: $legacy_doctor_dir" >&2
  rc=1
else
  BUNDLE_GEMFILE=Gemfile bundle exec rubocop \
    "$legacy_doctor_dir/agent-workflow-seam-doctor" \
    "$legacy_doctor_dir/agent-workflow-seam-doctor-test.rb" || rc=1
  ruby "$legacy_doctor_dir/agent-workflow-seam-doctor-test.rb" || rc=1
fi
BUNDLE_GEMFILE=Gemfile bundle exec rubocop \
  .agents/bin/agent_workflow_drift_manifest_test_test.rb \
  script/shaka_seam_check_test.rb || rc=1
ruby .agents/bin/agent_workflow_drift_manifest_test_test.rb || rc=1
if shaka_command=$(command -v shaka 2>/dev/null); then
  "$shaka_command" seam check --root . --local || rc=1
  shaka_realpath=$(ruby -e 'puts File.realpath(ARGV.fetch(0))' "$shaka_command")
  shaka_command_root=$(dirname "$shaka_realpath")
  if [ -f "$shaka_command_root/../lib/shaka/public_comments/trust_config.rb" ] || \
    [ -f "$shaka_command_root/../skills/shaka/lib/shaka/public_comments/trust_config.rb" ]; then
    SHAKA_COMMAND="$shaka_command" ruby script/shaka_seam_check_test.rb || rc=1
  else
    echo "Skipping Shaka library regression tests because the installed executable has no skill library." >&2
  fi
else
  echo "Skipping local Shaka seam checks because shaka is not installed." >&2
fi
pnpm run lint || rc=1
pnpm start format.listDifferent || rc=1
exit "$rc"
