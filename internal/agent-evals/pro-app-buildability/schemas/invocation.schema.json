{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "model",
    "scaffold_timeout_seconds",
    "probe_timeout_seconds",
    "maximum_agent_call_wall_clock_seconds",
    "sandbox",
    "ephemeral",
    "ignore_user_config",
    "ignore_rules",
    "strict_config",
    "multi_agent",
    "sandbox_network_access",
    "isolated_host_attestation",
    "capability_probe",
    "credential_store",
    "auth_material_available",
    "human_followups_sent",
    "shell_environment_policy"
  ],
  "properties": {
    "command": { "enum": ["codex exec", "claude -p"] },
    "agent": { "enum": ["codex", "claude"] },
    "model": { "type": "string", "minLength": 1 },
    "scaffold_timeout_seconds": { "type": "integer", "minimum": 1 },
    "probe_timeout_seconds": { "type": "integer", "minimum": 1 },
    "timeout_kill_grace_seconds": { "type": "integer", "minimum": 0 },
    "maximum_agent_call_wall_clock_seconds": { "type": "integer", "minimum": 2 },
    "sandbox": {
      "enum": ["workspace-write", "isolated-host-attested", "claude-permission-gated"]
    },
    "ephemeral": { "const": true },
    "ignore_user_config": { "const": true },
    "ignore_rules": { "const": true },
    "strict_config": { "const": true },
    "multi_agent": { "const": false },
    "sandbox_network_access": { "type": "boolean" },
    "isolated_host_attestation": { "type": "boolean" },
    "capability_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "rubygems"],
      "properties": {
        "npm": { "const": "npm view create-react-on-rails-app version --json" },
        "rubygems": { "const": "gem search --remote --exact '^rails$'" }
      }
    },
    "credential_store": { "const": "file" },
    "agent_configuration_mode": {
      "enum": ["codex-native", "claude-bare", "claude-safe-mode"]
    },
    "auth_material_available": { "type": "boolean" },
    "auth_source": { "enum": ["none", "operator-attested-file-broker"] },
    "human_followups_sent": { "const": 0 },
    "shell_environment_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "allowlist"],
      "properties": {
        "inherit": { "const": "none" },
        "allowlist": {
          "const": ["PATH", "HOME", "TMPDIR", "LANG", "LC_ALL", "SHELL", "CODEX_EVAL"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sandbox_network_access": { "const": true } } },
      "then": { "properties": { "isolated_host_attestation": { "const": true } } }
    },
    {
      "if": { "properties": { "auth_material_available": { "const": true } } },
      "then": {
        "properties": {
          "isolated_host_attestation": { "const": true },
          "auth_source": { "const": "operator-attested-file-broker" }
        },
        "required": ["auth_source"]
      },
      "else": { "properties": { "auth_source": { "const": "none" } } }
    },
    {
      "if": { "properties": { "agent": { "const": "codex" } }, "required": ["agent"] },
      "then": {
        "properties": {
          "command": { "const": "codex exec" },
          "agent_configuration_mode": { "const": "codex-native" }
        }
      }
    },
    {
      "if": { "properties": { "agent": { "const": "claude" } }, "required": ["agent"] },
      "then": {
        "properties": {
          "command": { "const": "claude -p" },
          "agent_configuration_mode": { "enum": ["claude-bare", "claude-safe-mode"] }
        }
      }
    },
    {
      "if": {
        "properties": { "agent_configuration_mode": { "const": "claude-safe-mode" } },
        "required": ["agent_configuration_mode"]
      },
      "then": {
        "properties": {
          "agent": { "const": "claude" },
          "auth_material_available": { "const": true },
          "auth_source": { "const": "operator-attested-file-broker" },
          "isolated_host_attestation": { "const": true }
        },
        "required": ["agent", "auth_source"]
      }
    },
    {
      "if": { "not": { "required": ["agent"] } },
      "then": {
        "properties": {
          "command": { "const": "codex exec" },
          "sandbox": { "const": "workspace-write" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": { "const": "codex" },
          "isolated_host_attestation": { "const": true }
        },
        "required": ["agent", "isolated_host_attestation"]
      },
      "then": { "properties": { "sandbox": { "const": "isolated-host-attested" } } }
    },
    {
      "if": {
        "properties": {
          "agent": { "const": "codex" },
          "isolated_host_attestation": { "const": false }
        },
        "required": ["agent", "isolated_host_attestation"]
      },
      "then": { "properties": { "sandbox": { "const": "workspace-write" } } }
    },
    {
      "if": {
        "properties": {
          "agent": { "const": "claude" },
          "isolated_host_attestation": { "const": true }
        },
        "required": ["agent", "isolated_host_attestation"]
      },
      "then": { "properties": { "sandbox": { "const": "isolated-host-attested" } } }
    },
    {
      "if": {
        "properties": {
          "agent": { "const": "claude" },
          "isolated_host_attestation": { "const": false }
        },
        "required": ["agent", "isolated_host_attestation"]
      },
      "then": { "properties": { "sandbox": { "const": "claude-permission-gated" } } }
    }
  ]
}
