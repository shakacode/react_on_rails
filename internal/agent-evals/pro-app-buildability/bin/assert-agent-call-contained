#!/usr/bin/env bash
set -euo pipefail

output="${1:-}"
[[ -n "$output" ]] || { echo "usage: $0 OUTPUT_PATH" >&2; exit 64; }
[[ ! -e "$output" && ! -L "$output" ]] || {
  echo "agent created the evidence output before runner publication" >&2
  exit 1
}

test_mode="${EVAL_AGENT_CONTAINMENT_TEST_MODE:-0}"
[[ "$test_mode" == 0 || "$test_mode" == 1 ]] || {
  echo "invalid agent containment test mode" >&2
  exit 1
}
if [[ "${EVAL_PROC_ROOT+x}" == x || "${EVAL_RUNNER_PID+x}" == x ]]; then
  [[ "$test_mode" == 1 ]] || {
    echo "process overrides require explicit test mode" >&2
    exit 1
  }
fi
[[ "${EVAL_ISOLATED_PID_NAMESPACE:-0}" == 1 ]] || exit 0

proc_root="/proc"
runner_pid="$PPID"
if [[ "$test_mode" == 1 ]]; then
  proc_root="${EVAL_PROC_ROOT:-/proc}"
  runner_pid="${EVAL_RUNNER_PID:-$PPID}"
else
  [[ "$runner_pid" != 1 ]] || {
    echo "attested eval runner is not supervised by namespace init" >&2
    exit 1
  }
  [[ "$(stat -f -c %T /proc 2>/dev/null)" == proc ]] || {
    echo "attested eval process root is not a genuine procfs" >&2
    exit 1
  }
  runner_parent=""
  while read -r status_key status_value _; do
    if [[ "$status_key" == PPid: ]]; then
      runner_parent="$status_value"
      break
    fi
  done <"$proc_root/$runner_pid/status"
  [[ "$runner_parent" == 1 ]] || {
    echo "attested eval runner is not supervised by namespace init" >&2
    exit 1
  }
fi
[[ -d "$proc_root" && "$runner_pid" =~ ^[1-9][0-9]*$ ]] || {
  echo "invalid process inspection configuration" >&2
  exit 1
}
shopt -s nullglob dotglob
process_dirs=("$proc_root"/[0-9]*)
((${#process_dirs[@]} > 0)) || {
  echo "process inspection found no process directories" >&2
  exit 1
}
for process_dir in "${process_dirs[@]}"; do
  process_entries=("$process_dir"/*)
  ((${#process_entries[@]} > 0)) || {
    echo "process directory is empty" >&2
    exit 1
  }
  process_pid="${process_dir##*/}"
  [[ "$process_pid" == 1 || "$process_pid" == "$runner_pid" || "$process_pid" == "$$" ]] && continue
  echo "agent process remains after the agent call" >&2
  exit 1
done
