#!/usr/bin/env bash
set -euo pipefail
umask 077

output="${1:-}"
[[ "$#" == 1 && "$output" = /* && ! -e "$output" && ! -L "$output" && \
  -d "$(dirname "$output")" ]] || {
  echo "usage: build-claude-credential-helper NEW_ABSOLUTE_PATH" >&2
  exit 64
}

# These variables intentionally expand only when Claude invokes the generated
# helper. The canonical credential is newline-free, so POSIX read reports EOF
# after assigning it; accept that status only when a nonempty value was read.
# shellcheck disable=SC2016
printf '%s\n' '#!/bin/sh' 'set -eu' 'helper_dir=${0%/*}' \
  'credential=' \
  'IFS= read -r credential <"$helper_dir/model-credential" || [ -n "$credential" ]' \
  '[ -n "$credential" ]' \
  'printf "%s" "$credential"' >"$output"
chmod 700 "$output"
