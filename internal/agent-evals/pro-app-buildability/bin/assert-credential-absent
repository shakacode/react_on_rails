#!/usr/bin/env bash
# Fail closed unless the operator-provided model credential is entirely absent
# from the committed run output. This enforces the `auth_material_persisted:false`
# invariant at runtime: the broker seeds the credential ONLY into the mode-0700
# private directory, never into the evidence surface. The check never prints or
# passes credential bytes as arguments. It searches each artifact as a binary
# stream so an exact credential embedded inside a larger file is also rejected.
set -euo pipefail

output_dir="${1:-}"
credential_file="${2:-}"
[[ -d "$output_dir" && -f "$credential_file" ]] || {
  echo "usage: assert-credential-absent OUTPUT_DIRECTORY CREDENTIAL_FILE" >&2
  exit 64
}

credential_real="$(realpath "$credential_file")"
output_real="$(realpath "$output_dir")"
case "$credential_real/" in
  "$output_real/"*)
    echo "operator credential path resolves inside the run output: $output_dir" >&2
    exit 1
    ;;
esac

set +e
perl -MFile::Find -e '
  use strict;
  use warnings;

  my ($credential_path, $output_path) = @ARGV;
  open my $credential_fh, "<", $credential_path or die "cannot read credential file\n";
  binmode $credential_fh;
  local $/;
  my $credential = <$credential_fh>;
  close $credential_fh or die "cannot close credential file\n";
  die "credential file must not be empty\n" unless defined($credential) && length($credential);
  die "credential file exceeds 1048576-byte limit\n" if length($credential) > 1_048_576;

  my $credential_length = length($credential);
  my $leak_path;
  find(
    {
      no_chdir => 1,
      wanted => sub {
        return if defined $leak_path;
        my $path = $File::Find::name;
        lstat($path) or die "cannot inspect run output artifact\n";
        die "run output contains a symbolic link\n" if -l _;
        return unless -f _;

        open my $artifact_fh, "<", $path or die "cannot read run output artifact\n";
        binmode $artifact_fh;
        my $carry = "";
        while (1) {
          my $bytes_read = read($artifact_fh, my $chunk, 65_536);
          die "cannot read run output artifact\n" unless defined $bytes_read;
          last if $bytes_read == 0;
          my $candidate = $carry . $chunk;
          if (index($candidate, $credential) >= 0) {
            $leak_path = $path;
            last;
          }
          my $carry_length = $credential_length - 1;
          $carry = $carry_length > 0 && length($candidate) > $carry_length
            ? substr($candidate, -$carry_length)
            : $candidate;
        }
        close $artifact_fh or die "cannot close run output artifact\n";
      },
    },
    $output_path,
  );

  exit(1) if defined $leak_path;
  exit(0);
' "$credential_real" "$output_real"
scan_exit=$?
set -e
case "$scan_exit" in
  0) ;;
  1)
    echo "operator credential bytes found in run output" >&2
    exit 1
    ;;
  *)
    echo "credential absence scan failed closed" >&2
    exit 2
    ;;
esac

exit 0
