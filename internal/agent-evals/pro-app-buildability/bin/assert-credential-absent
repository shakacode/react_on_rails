#!/usr/bin/env bash
# Fail closed unless the operator-provided model credential is entirely absent
# from the committed run output. This enforces the `auth_material_persisted:false`
# invariant at runtime: the broker seeds the credential ONLY into the mode-0700
# private directory, never into the evidence surface. The check never prints or
# passes credential bytes as arguments. It searches each artifact as a binary
# stream so an exact credential embedded inside a larger file is also rejected.
set -euo pipefail

output_dir="${1:-}"
credential_file="${2:-}"
[[ -d "$output_dir" && ( "$credential_file" == - || -f "$credential_file" ) ]] || {
  echo "usage: assert-credential-absent OUTPUT_DIRECTORY CREDENTIAL_FILE_OR_STDIN" >&2
  exit 64
}

output_real="$(realpath "$output_dir")"
credential_real="$credential_file"
if [[ "$credential_file" != - ]]; then
  credential_real="$(realpath "$credential_file")"
  case "$credential_real/" in
    "$output_real/"*)
      echo "operator credential path resolves inside the run output: $output_dir" >&2
      exit 1
      ;;
  esac
fi

set +e
perl -MFile::Find -MJSON::PP=decode_json -e '
  use strict;
  use warnings;

  my ($credential_path, $output_path) = @ARGV;
  my $credential_fh;
  if ($credential_path eq "-") {
    $credential_fh = \*STDIN;
  } else {
    open $credential_fh, "<", $credential_path or die "cannot read credential file\n";
  }
  binmode $credential_fh;
  local $/;
  my $credential = <$credential_fh>;
  close $credential_fh or die "cannot close credential file\n" unless $credential_path eq "-";
  die "credential file must not be empty\n" unless defined($credential) && length($credential);
  die "credential file exceeds 1048576-byte limit\n" if length($credential) > 1_048_576;

  my @needles = ($credential);
  my $decoded = eval { decode_json($credential) };
  if (!$@ && ref($decoded) eq "HASH") {
    my @sensitive_values;
    my $collect_sensitive;
    $collect_sensitive = sub {
      my ($value, $sensitive_context) = @_;
      if (ref($value) eq "HASH") {
        for my $key (keys %{$value}) {
          my $key_is_sensitive = $key =~ /(?:auth|cookie|credential|key|password|secret|token)/i;
          $collect_sensitive->($value->{$key}, $sensitive_context || $key_is_sensitive);
        }
      } elsif (ref($value) eq "ARRAY") {
        $collect_sensitive->($_, $sensitive_context) for @{$value};
      } elsif (!ref($value) && $sensitive_context && defined($value) && length($value) >= 8) {
        push @sensitive_values, $value;
      }
    };
    $collect_sensitive->($decoded, 0);
    push @needles, @sensitive_values;
  }
  my %seen;
  @needles = grep { !$seen{$_}++ } @needles;
  my $maximum_needle_length = 0;
  for my $needle (@needles) {
    $maximum_needle_length = length($needle) if length($needle) > $maximum_needle_length;
  }
  my $leak_path;
  find(
    {
      no_chdir => 1,
      wanted => sub {
        return if defined $leak_path;
        my $path = $File::Find::name;
        lstat($path) or die "cannot inspect run output artifact\n";
        die "run output contains a symbolic link\n" if -l _;
        return unless -f _;

        open my $artifact_fh, "<", $path or die "cannot read run output artifact\n";
        binmode $artifact_fh;
        my $carry = "";
        while (1) {
          my $bytes_read = read($artifact_fh, my $chunk, 65_536);
          die "cannot read run output artifact\n" unless defined $bytes_read;
          last if $bytes_read == 0;
          my $candidate = $carry . $chunk;
          if (grep { index($candidate, $_) >= 0 } @needles) {
            $leak_path = $path;
            last;
          }
          my $carry_length = $maximum_needle_length - 1;
          $carry = $carry_length > 0 && length($candidate) > $carry_length
            ? substr($candidate, -$carry_length)
            : $candidate;
        }
        close $artifact_fh or die "cannot close run output artifact\n";
      },
    },
    $output_path,
  );

  exit(1) if defined $leak_path;
  exit(0);
' "$credential_real" "$output_real"
scan_exit=$?
set -e
case "$scan_exit" in
  0) ;;
  1)
    echo "operator credential bytes found in run output" >&2
    exit 1
    ;;
  *)
    echo "credential absence scan failed closed" >&2
    exit 2
    ;;
esac

exit 0
