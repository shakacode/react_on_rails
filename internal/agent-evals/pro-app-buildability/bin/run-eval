#!/usr/bin/env bash
set -euo pipefail
umask 077

usage() {
  echo "usage: $0 --agent codex|claude --model MODEL --timeout SECONDS --workspace ABSOLUTE_PATH --output PATH [--run-id ID] [--model-credential-file FILE] [--model-credential-stdin] [--model-credential-format native|claude-oauth] [--ack-disposable-secret-free-host]" >&2
}

agent=""
model=""
timeout_seconds=""
workspace=""
output=""
run_id=""
model_credential_file=""
model_credential_fd=9
model_credential_stdin=false
model_credential_format=native
isolated_host_attestation=false
while (($#)); do
  case "$1" in
    --agent) agent="${2:-}"; shift 2 ;;
    --model) model="${2:-}"; shift 2 ;;
    --timeout) timeout_seconds="${2:-}"; shift 2 ;;
    --workspace) workspace="${2:-}"; shift 2 ;;
    --output) output="${2:-}"; shift 2 ;;
    --run-id) run_id="${2:-}"; shift 2 ;;
    --model-credential-file) model_credential_file="${2:-}"; shift 2 ;;
    --model-credential-stdin) model_credential_stdin=true; shift ;;
    --model-credential-format) model_credential_format="${2:-}"; shift 2 ;;
    --ack-disposable-secret-free-host) isolated_host_attestation=true; shift ;;
    *) usage; exit 64 ;;
  esac
done

[[ "$agent" == codex || "$agent" == claude ]] || { usage; exit 64; }
[[ -n "$model" && "$timeout_seconds" =~ ^[1-9][0-9]*$ && "$workspace" = /* && -n "$output" ]] || {
  usage
  exit 64
}
[[ -z "$model_credential_file" || "$model_credential_stdin" == false ]] || {
  echo "choose exactly one model credential source" >&2
  exit 64
}
[[ "$model_credential_format" == native || \
  ( "$agent" == claude && "$model_credential_format" == claude-oauth ) ]] || {
  echo "unsupported model credential format" >&2
  exit 64
}
auth_requested=false
if [[ -n "$model_credential_file" || "$model_credential_stdin" == true ]]; then
  auth_requested=true
  [[ "$isolated_host_attestation" == true ]] || {
    echo "model credentials require --ack-disposable-secret-free-host" >&2
    exit 65
  }
  if [[ -n "$model_credential_file" ]]; then
    [[ ! -L "$model_credential_file" && -f "$model_credential_file" && -s "$model_credential_file" ]] || {
      echo "model credential must be a nonempty regular file, not a symbolic link" >&2
      exit 65
    }
  fi
fi
[[ "$model_credential_format" != claude-oauth || "$auth_requested" == true ]] || {
  echo "Claude OAuth credential format requires a credential source" >&2
  exit 64
}

root="$(realpath "$(git rev-parse --show-toplevel)")"
eval_dir="$root/internal/agent-evals/pro-app-buildability"
dependency_root="${EVAL_HARNESS_DEPENDENCY_ROOT:-$eval_dir}"
if command -v timeout >/dev/null; then
  timeout_name=timeout
elif command -v gtimeout >/dev/null; then
  timeout_name=gtimeout
else
  echo "GNU timeout or gtimeout is required; refusing an unbounded run" >&2
  exit 69
fi
required_commands=("$agent" curl env git head jq node npm perl pnpm realpath ruby shasum sleep stat unlink "$timeout_name")
safe_path="$(SAFE_PATH_SOURCE="$PATH" BASH_ENV=/dev/null "$eval_dir/bin/build-safe-path" \
  "${required_commands[@]}")"

resolve_future_path() {
  local requested="$1"
  local parent
  parent="$(dirname "$requested")"
  [[ -d "$parent" ]] || { echo "parent directory must exist: $parent" >&2; return 1; }
  printf '%s/%s\n' "$(cd "$parent" && pwd -P)" "$(basename "$requested")"
}

if [[ "$output" != /* ]]; then output="$root/$output"; fi
[[ ! -L "$workspace" ]] || { echo "workspace symlink inputs are forbidden" >&2; exit 65; }
[[ ! -L "$output" ]] || { echo "output symlink inputs are forbidden" >&2; exit 65; }
workspace="$(resolve_future_path "$workspace")"
output="$(resolve_future_path "$output")"
[[ -n "$run_id" ]] || run_id="$(basename "$output")"
[[ "$run_id" =~ ^[A-Za-z0-9._-]+$ ]] || {
  echo "run ID must match ^[A-Za-z0-9._-]+$" >&2
  exit 65
}
if [[ -n "$model_credential_file" ]]; then
  model_credential_file="$(realpath "$model_credential_file")"
  case "$model_credential_file" in
    "$root"/*) echo "model credential must be outside the repository" >&2; exit 65 ;;
  esac
  case "$model_credential_file" in
    "$workspace"|"$workspace"/*|"$output"|"$output"/*)
      echo "model credential must be outside the workspace and output" >&2
      exit 65
      ;;
  esac
fi
case "$workspace/" in "$output/"*) echo "workspace and output overlap" >&2; exit 65 ;; esac
case "$output/" in "$workspace/"*) echo "workspace and output overlap" >&2; exit 65 ;; esac
case "$workspace/" in "$root/"*) echo "workspace must be outside the repository" >&2; exit 65 ;; esac
[[ -z "$(git -C "$root" status --porcelain=v1)" ]] || {
  echo "repository must be clean so the recorded revision identifies the harness exactly" >&2
  exit 65
}
[[ ! -e "$output" ]] || { echo "output already exists: $output" >&2; exit 65; }
if [[ "$isolated_host_attestation" == true && \
  ("${EVAL_ISOLATED_PID_NAMESPACE:-0}" != 1 || "$$" == 1 || "$PPID" != 1) ]]; then
  echo "attested evals require the isolated PID namespace wrapper" >&2
  exit 65
fi
if [[ -e "$workspace" && -n "$(find "$workspace" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
  echo "workspace must be absent or empty: $workspace" >&2
  exit 65
fi

private_dir="$(mktemp -d "${TMPDIR:-/tmp}/ror-pro-agent-eval.XXXXXX")"
chmod 700 "$private_dir"
agent_state_dir="$workspace/.ror-eval-state"
output_publishable=false
remove_agent_state() {
  [[ -e "$agent_state_dir" ]] || return 0
  chmod -R u+rwX "$agent_state_dir" 2>/dev/null || true
  rm -rf "$agent_state_dir"
}
cleanup() {
  # Evidence is publishable only after final validation and any credential
  # scan. Remove the exact, prevalidated output path on every earlier exit so
  # a rejected partial run cannot be mistaken for completed evidence.
  if [[ "$output_publishable" == false && ( -e "$output" || -L "$output" ) ]]; then
    rm -rf "$output"
  fi
  remove_agent_state
  rm -rf "$private_dir"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
mkdir -p "$workspace"
chmod 700 "$workspace"
mkdir -m 700 "$private_dir/runner-home" "$private_dir/agent-home" "$private_dir/codex-home" "$private_dir/tmp"
safe_path="$("$eval_dir/bin/prepare-agent-state" "$agent_state_dir" \
  "$private_dir/runner-home" "$private_dir/agent-home" "$safe_path")"

minimal_env=(env -i "PATH=$safe_path" "HOME=$private_dir/runner-home" "TMPDIR=$private_dir/tmp" LANG=C LC_ALL=C SHELL=/bin/sh CODEX_EVAL=1)
for command_name in "${required_commands[@]}"; do
  expected_executable="$(realpath "$(SAFE_PATH_SOURCE="$PATH" BASH_ENV=/dev/null \
    "$eval_dir/bin/build-safe-path" --resolve "$command_name")")"
  # The positional parameter expands inside the stripped child shell.
  # shellcheck disable=SC2016
  runtime_executable="$("${minimal_env[@]}" /bin/sh -c 'command -v "$1"' sh "$command_name")" || {
    echo "required command unavailable in stripped runtime: $command_name" >&2
    exit 69
  }
  runtime_executable="$(realpath "$runtime_executable")"
  [[ "$runtime_executable" == "$expected_executable" ]] || {
    echo "stripped runtime resolves a different executable: $command_name" >&2
    exit 69
  }
done
# The positional parameter expands inside the stripped child shell.
# shellcheck disable=SC2016
timeout_command="$("${minimal_env[@]}" /bin/sh -c 'command -v "$1"' sh "$timeout_name")"
timeout_kill_grace_seconds=10

auth_material_available="$auth_requested"
auth_source=none
brokered_credential=""
credential_snapshot=""
claude_settings="$private_dir/claude-settings.json"
claude_oauth=false
if [[ "$auth_material_available" == true ]]; then
  auth_source=operator-attested-file-broker
  if [[ "$agent" == codex ]]; then
    brokered_credential="$private_dir/codex-home/auth.json"
  elif [[ "$model_credential_format" == claude-oauth ]]; then
    brokered_credential="$private_dir/model-credential.input"
    claude_oauth=true
  else
    brokered_credential="$private_dir/model-credential"
  fi
  if [[ "$model_credential_stdin" == true ]]; then
    head -c 1048577 >"$brokered_credential"
  else
    exec 9<"$model_credential_file" || {
      echo "cannot open model credential" >&2
      exit 65
    }
    credential_metadata="$("$eval_dir/bin/file-descriptor-metadata" "$model_credential_fd")" || {
      echo "cannot inspect model credential" >&2
      exit 65
    }
    IFS=: read -r credential_kind credential_mode credential_size <<<"$credential_metadata"
    [[ "$credential_kind" == regular && "$credential_size" =~ ^[1-9][0-9]*$ ]] || {
      echo "model credential must be a nonempty regular file" >&2
      exit 65
    }
    [[ "$credential_size" -le 1048576 ]] || {
      echo "model credential exceeds 1048576-byte limit" >&2
      exit 65
    }
    [[ "$credential_mode" =~ ^[0-7]{4}$ ]] || { echo "unexpected model credential mode" >&2; exit 65; }
    (( (8#$credential_mode & 077) == 0 )) || {
      echo "model credential must not be group- or world-accessible" >&2
      exit 65
    }
    head -c 1048577 <&"$model_credential_fd" >"$brokered_credential"
    exec 9<&-
  fi
  [[ -s "$brokered_credential" && "$(wc -c <"$brokered_credential" | tr -d ' ')" -le 1048576 ]] || {
    echo "brokered model credential must contain 1 to 1048576 bytes" >&2
    exit 65
  }
  if [[ "$agent" == codex ]]; then
    chmod 600 "$brokered_credential"
    jq -e 'type == "object"' "$brokered_credential" >/dev/null 2>&1 || {
      echo "Codex model credential must be a JSON object suitable for auth.json" >&2
      exit 65
    }
  else
    if [[ "$claude_oauth" == true ]]; then
      claude_credentials_dir="$private_dir/runner-home/.claude"
      mkdir -m 700 "$claude_credentials_dir"
      oauth_credential="$claude_credentials_dir/.credentials.json"
      "$eval_dir/bin/canonicalize-model-credential" claude-oauth \
        "$brokered_credential" "$oauth_credential"
      brokered_credential="$oauth_credential"
      credential_snapshot="$(<"$brokered_credential")"
      # The raw operator JSON can contain unrelated stores such as mcpOAuth.
      # Only the minimized native store may survive into either agent call.
      unlink "$private_dir/model-credential.input"
      jq -n '{}' >"$claude_settings"
    else
      "$eval_dir/bin/canonicalize-model-credential" claude "$brokered_credential"
      chmod 600 "$brokered_credential"
      credential_helper="$private_dir/credential-helper"
      "$eval_dir/bin/build-claude-credential-helper" "$credential_helper"
      # TMPDIR expands only when Claude invokes the command under the stripped child environment.
      # shellcheck disable=SC2016
      credential_helper_command='/bin/sh "$TMPDIR/../credential-helper"'
      jq -n --arg helper "$credential_helper_command" '{apiKeyHelper:$helper}' >"$claude_settings"
    fi
  fi
  # Preserve the originally brokered bytes in runner memory. The selected CLI
  # shares our UID and may rotate or replace its writable credential file; leak
  # checks must never switch to those later bytes.
  [[ -n "$credential_snapshot" ]] || credential_snapshot="$(<"$brokered_credential")"
else
  jq -n '{}' >"$claude_settings"
fi
network_json='[]'
for endpoint in https://registry.npmjs.org/ https://rubygems.org/; do
  if "${minimal_env[@]}" curl --fail --silent --show-error --head --max-time 10 "$endpoint" >/dev/null; then
    network_json="$(jq --arg endpoint "$endpoint" '. + [{endpoint:$endpoint,status:"pass"}]' <<<"$network_json")"
  else
    echo "required network preflight failed: $endpoint" >&2
    exit 69
  fi
done

stripped_categories='[]'
while IFS= read -r variable; do
  case "$variable" in
    *TOKEN*|*token*) category=token ;;
    *PASSWORD*|*password*|*PASSWD*|*passwd*) category=password ;;
    *AUTH*|*auth*) category=auth ;;
    *COOKIE*|*cookie*) category=cookie ;;
    *CREDENTIAL*|*credential*) category=credential ;;
    *SECRET*|*secret*|*API_KEY*|*api_key*|*LICENSE*|*license*) category=secret ;;
    *) continue ;;
  esac
  stripped_categories="$(jq --arg category "$category" '. + [$category] | unique | sort' \
    <<<"$stripped_categories")"
done < <(compgen -e)

git -C "$workspace" init --quiet
started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
revision="$(git -C "$root" rev-parse HEAD)"

input_hashes='[]'
while IFS= read -r file; do
  relative="${file#"$eval_dir/"}"
  executable=false
  [[ -x "$file" ]] && executable=true
  input_hashes="$(jq --arg path "$relative" --arg sha "$(shasum -a 256 "$file" | awk '{print $1}')" \
    --argjson executable "$executable" '. + [{path:$path,sha256:$sha,executable:$executable}]' <<<"$input_hashes")"
done < <(find "$eval_dir/bin" "$eval_dir/isolated-host" "$eval_dir/schemas" -type f -print | LC_ALL=C sort)
for file in network-probe-prompt.md package.json pnpm-lock.yaml prompt.md rubric.md scenario.md; do
  input_hashes="$(jq --arg path "$file" --arg sha "$(shasum -a 256 "$eval_dir/$file" | awk '{print $1}')" \
    '. + [{path:$path,sha256:$sha,executable:false}]' <<<"$input_hashes")"
done

sandbox_network_access="$isolated_host_attestation"
execution_boundary="workspace-write"
if [[ "$isolated_host_attestation" == true ]]; then
  execution_boundary="isolated-host-attested"
elif [[ "$agent" == claude ]]; then
  execution_boundary="claude-permission-gated"
fi
shell_policy="shell_environment_policy.set={PATH=\"$safe_path\",HOME=\"$private_dir/agent-home\",TMPDIR=\"$private_dir/tmp\",LANG=\"C\",LC_ALL=\"C\",SHELL=\"/bin/sh\",CODEX_EVAL=\"1\"}"
npm_probe_command='npm view create-react-on-rails-app version --json'
rubygems_probe_command="gem search --remote --exact '^rails$'"
agent_command="codex exec"
agent_configuration_mode="codex-native"
if [[ "$agent" == codex ]]; then
  agent_args=(exec --ephemeral --ignore-user-config --ignore-rules --strict-config --model "$model")
  if [[ "$isolated_host_attestation" == true ]]; then
    agent_args+=(--dangerously-bypass-approvals-and-sandbox)
  else
    agent_args+=(--sandbox workspace-write)
    agent_args+=(-c "sandbox_workspace_write.network_access=$sandbox_network_access")
  fi
  agent_args+=(-c 'features.multi_agent=false')
  agent_args+=(-c 'cli_auth_credentials_store="file"')
  agent_args+=(-c 'shell_environment_policy.inherit="none"' -c "$shell_policy")
  agent_args+=(--output-schema "$eval_dir/schemas/agent-report.schema.json" --json -C "$workspace" -)
else
  agent_command="claude -p"
  agent_args=(-p --no-session-persistence --disable-slash-commands --no-chrome)
  if [[ "$claude_oauth" == true ]]; then
    agent_configuration_mode="claude-safe-mode"
    agent_args+=(--safe-mode)
  else
    agent_configuration_mode="claude-bare"
    agent_args+=(--bare)
  fi
  agent_args+=(--strict-mcp-config --mcp-config '{"mcpServers":{}}' --tools 'Bash,Read,Write,Edit,Glob,Grep')
  agent_args+=(--model "$model" --output-format stream-json --verbose --settings "$claude_settings")
  agent_args+=(--json-schema "$("$eval_dir/bin/build-claude-agent-report-schema")")
  [[ "$isolated_host_attestation" == true ]] && agent_args+=(--dangerously-skip-permissions)
fi
agent_version="$("${minimal_env[@]}" "$agent" --version 2>&1)"

run_agent() {
  local prompt_file="$1"
  local call_timeout="$2"
  local stderr_file="$3"
  if [[ "$agent" == codex ]]; then
    "$eval_dir/bin/run-with-timeout" "$timeout_command" "$timeout_kill_grace_seconds" \
      "$call_timeout" "$stderr_file" \
      "${minimal_env[@]}" "CODEX_HOME=$private_dir/codex-home" \
      codex "${agent_args[@]}" <"$prompt_file"
  else
    (cd "$workspace" && "$eval_dir/bin/run-with-timeout" "$timeout_command" \
      "$timeout_kill_grace_seconds" "$call_timeout" "$stderr_file" \
      "${minimal_env[@]}" claude "${agent_args[@]}" <"$prompt_file")
  fi
}

normalize_agent_events() {
  local raw_events="$1"
  local normalized_events="$2"
  local agent_exit_code="$3"
  if [[ "$agent" == codex ]]; then
    node "$eval_dir/bin/normalize-codex-events.mjs" "$raw_events" "$normalized_events"
  else
    node "$eval_dir/bin/normalize-claude-events.mjs" \
      "$raw_events" "$normalized_events" "$agent_exit_code"
  fi
}

assert_credential_absent() {
  local scan_target="$1"
  local symlink_policy="${2:-}"
  local scan_args=("$agent" "$scan_target" "$brokered_credential")
  [[ -z "$symlink_policy" ]] || scan_args+=("$symlink_policy")
  printf '%s' "$credential_snapshot" |
    "$eval_dir/bin/assert-brokered-credential-absent" "${scan_args[@]}"
}

scan_evidence_for_sensitive_artifacts() {
  local evidence_directory="$1"
  local sensitive_scan_exit=0
  "$eval_dir/bin/scan-sensitive-artifacts" "$evidence_directory" >/dev/null 2>&1 ||
    sensitive_scan_exit=$?
  case "$sensitive_scan_exit" in
    0) echo "sensitive-artifact scan rejected evidence" >&2; return 1 ;;
    1) return 0 ;;
    *) echo "sensitive-artifact scan failed" >&2; return 1 ;;
  esac
}

probe_timeout_seconds="$timeout_seconds"
((probe_timeout_seconds > 120)) && probe_timeout_seconds=120
maximum_agent_call_wall_clock_seconds=$((probe_timeout_seconds + timeout_seconds +
  (2 * timeout_kill_grace_seconds)))

invocation_json="$(jq -n --arg command "$agent_command" --arg agent "$agent" --arg model "$model" \
  --arg execution_boundary "$execution_boundary" \
  --arg agent_configuration_mode "$agent_configuration_mode" \
  --arg auth_source "$auth_source" --argjson auth_material_available "$auth_material_available" \
  --argjson scaffold_timeout "$timeout_seconds" \
  --argjson probe_timeout "$probe_timeout_seconds" \
  --argjson timeout_kill_grace "$timeout_kill_grace_seconds" \
  --argjson maximum_agent_wall_clock "$maximum_agent_call_wall_clock_seconds" \
  --arg npm_probe "$npm_probe_command" --arg rubygems_probe "$rubygems_probe_command" \
  --argjson sandbox_network_access "$sandbox_network_access" \
  --argjson isolated_host_attestation "$isolated_host_attestation" \
  '{command:$command,agent:$agent,model:$model,scaffold_timeout_seconds:$scaffold_timeout,
    probe_timeout_seconds:$probe_timeout,timeout_kill_grace_seconds:$timeout_kill_grace,
    maximum_agent_call_wall_clock_seconds:$maximum_agent_wall_clock,
    sandbox:$execution_boundary,ephemeral:true,
    ignore_user_config:true,ignore_rules:true,strict_config:true,multi_agent:false,
    sandbox_network_access:$sandbox_network_access,isolated_host_attestation:$isolated_host_attestation,
    capability_probe:{npm:$npm_probe,rubygems:$rubygems_probe},
    credential_store:"file",agent_configuration_mode:$agent_configuration_mode,
    auth_material_available:$auth_material_available,auth_source:$auth_source,
    human_followups_sent:0,
    shell_environment_policy:{inherit:"none",allowlist:["PATH","HOME","TMPDIR","LANG","LC_ALL","SHELL","CODEX_EVAL"]}}')"

raw_probe_events="$private_dir/probe-events.jsonl"
normalized_probe_events="$private_dir/probe-events.normalized.jsonl"
raw_probe_stderr="$private_dir/probe-stderr.log"
safe_probe_events="$private_dir/probe-events.safe.jsonl"
safe_probe_stderr="$private_dir/probe-stderr.safe.log"
set +e
run_agent "$eval_dir/network-probe-prompt.md" "$probe_timeout_seconds" "$raw_probe_stderr" \
  >"$raw_probe_events"
probe_exit=$?
set -e
"$eval_dir/bin/quiesce-agent-call" "$output"
"$eval_dir/bin/assert-agent-call-contained" "$output"
if [[ "$auth_material_available" == true ]]; then
  assert_credential_absent "$workspace" --skip-symlinks
fi
normalize_agent_events "$raw_probe_events" "$normalized_probe_events" "$probe_exit"
EVAL_PRIVATE_DIR="$private_dir" EVAL_WORKSPACE="$workspace" EVAL_OUTPUT="$output" \
  perl "$eval_dir/bin/sanitize-events.pl" --jsonl "$normalized_probe_events" >"$safe_probe_events"
EVAL_PRIVATE_DIR="$private_dir" EVAL_WORKSPACE="$workspace" EVAL_OUTPUT="$output" \
  perl "$eval_dir/bin/sanitize-events.pl" "$raw_probe_stderr" >"$safe_probe_stderr"
network_probe_file="$private_dir/sandbox-network-probe.json"
node "$eval_dir/bin/derive-network-probe.mjs" "$safe_probe_events" "$network_probe_file" \
  "$sandbox_network_access"
probe_result="$(jq -r .overall "$network_probe_file")"
network_probe_json="$(<"$network_probe_file")"
safe_probe_events_text="$(<"$safe_probe_events")"
safe_probe_stderr_text="$(<"$safe_probe_stderr")"
rm -f "$raw_probe_events" "$normalized_probe_events" "$raw_probe_stderr" \
  "$safe_probe_events" "$safe_probe_stderr" "$network_probe_file"

safe_events="$private_dir/events.safe.jsonl"
safe_stderr="$private_dir/stderr.safe.log"
scaffold_invoked=false
runner_exit="$probe_exit"
timed_out=false
[[ "$probe_exit" == 124 ]] && timed_out=true
if "$eval_dir/bin/probe-allows-scaffold" "$probe_exit" "$probe_result" "$sandbox_network_access"; then
  scaffold_invoked=true
  raw_scaffold_events="$private_dir/scaffold-events.jsonl"
  normalized_scaffold_events="$private_dir/scaffold-events.normalized.jsonl"
  raw_scaffold_stderr="$private_dir/scaffold-stderr.log"
  safe_scaffold_events="$private_dir/scaffold-events.safe.jsonl"
  safe_scaffold_stderr="$private_dir/scaffold-stderr.safe.log"
  set +e
  run_agent "$eval_dir/prompt.md" "$timeout_seconds" "$raw_scaffold_stderr" \
    >"$raw_scaffold_events"
  runner_exit=$?
  set -e
  "$eval_dir/bin/quiesce-agent-call" "$output"
  "$eval_dir/bin/assert-agent-call-contained" "$output"
  [[ "$runner_exit" == 124 ]] && timed_out=true
  if [[ "$auth_material_available" == true ]]; then
    assert_credential_absent "$workspace" --skip-symlinks
  fi
  normalize_agent_events "$raw_scaffold_events" "$normalized_scaffold_events" "$runner_exit"
  EVAL_PRIVATE_DIR="$private_dir" EVAL_WORKSPACE="$workspace" EVAL_OUTPUT="$output" \
    perl "$eval_dir/bin/sanitize-events.pl" --jsonl "$normalized_scaffold_events" >"$safe_scaffold_events"
  EVAL_PRIVATE_DIR="$private_dir" EVAL_WORKSPACE="$workspace" EVAL_OUTPUT="$output" \
    perl "$eval_dir/bin/sanitize-events.pl" "$raw_scaffold_stderr" >"$safe_scaffold_stderr"
  printf '%s\n' "$safe_probe_events_text" >"$safe_events"
  cat "$safe_scaffold_events" >>"$safe_events"
  printf '%s\n' "$safe_probe_stderr_text" >"$safe_stderr"
  cat "$safe_scaffold_stderr" >>"$safe_stderr"
  agent_report_file="$private_dir/agent-report.json"
  if ! jq -s '[.[] | select(.type == "item.completed" and .item.type == "agent_message") | .item.text] | last // empty | fromjson' \
    "$safe_scaffold_events" >"$agent_report_file" || [[ ! -s "$agent_report_file" ]]; then
    jq -n --arg reason "$agent scaffold runner exited without a schema-constrained final report (exit $runner_exit)" \
      '{status:"failed",summary:$reason,commands:[],checks:[],friction:[$reason],human_interventions:0,blockers:[$reason]}' \
      >"$agent_report_file"
  fi
else
  printf '%s\n' "$safe_probe_events_text" >"$safe_events"
  printf '%s\n' "$safe_probe_stderr_text" >"$safe_stderr"
  agent_report_file="$private_dir/agent-report.json"
  jq -n --arg reason "In-sandbox npm/RubyGems capability probe failed; scaffold was not started" \
    '{status:"blocked",summary:$reason,commands:[],checks:[],friction:[$reason],human_interventions:0,blockers:[$reason]}' \
    >"$agent_report_file"
fi
sanitized_agent_report_file="$private_dir/agent-report.sanitized.json"
"${minimal_env[@]}" "EVAL_HARNESS_DEPENDENCY_ROOT=$dependency_root" node \
  "$eval_dir/bin/sanitize-agent-report.mjs" "$agent_report_file" "$sanitized_agent_report_file"
mv "$sanitized_agent_report_file" "$agent_report_file"
remove_agent_state

evidence_dir="$private_dir/evidence"
mkdir -m 700 "$evidence_dir"
cp "$eval_dir/prompt.md" "$eval_dir/scenario.md" "$eval_dir/rubric.md" "$evidence_dir/"
cp "$agent_report_file" "$evidence_dir/agent-report.json"
printf '%s\n' "$invocation_json" >"$evidence_dir/invocation.json"
printf '%s\n' "$network_probe_json" >"$evidence_dir/sandbox-network-probe.json"

TMPDIR="$private_dir/tmp" "$eval_dir/bin/build-runner-diagnostics" \
  "$safe_stderr" "$evidence_dir/runner-diagnostics.json"

node "$eval_dir/bin/derive-evidence.mjs" "$safe_events" "$workspace" "$evidence_dir" \
  "$evidence_dir/agent-report.json" "$evidence_dir/invocation.json"
git -C "$workspace" status --short --untracked-files=normal >"$evidence_dir/workspace-status.txt"

finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
classification="$(jq -r .overall "$evidence_dir/rubric-results.json")"
reason="Machine-derived rubric result: $classification; see rubric-results.json"

jq -n \
  --arg run_id "$run_id" --arg started "$started_at" --arg finished "$finished_at" \
  --arg revision "$revision" --arg agent "$agent" --arg version "$agent_version" --arg model "$model" \
  --arg agent_configuration_mode "$agent_configuration_mode" \
  --arg auth_source "$auth_source" --argjson auth_material_available "$auth_material_available" \
  --arg os "$(uname -srm)" --arg ruby "$(ruby --version 2>&1)" --arg node "$(node --version)" \
  --arg npm "$(npm --version)" --arg pnpm "$(pnpm --version)" --arg git "$(git --version)" \
  --argjson inputs "$input_hashes" --argjson stripped "$stripped_categories" --argjson network "$network_json" \
  --argjson sandbox_network_access "$sandbox_network_access" \
  --arg execution_boundary "$execution_boundary" \
  --argjson isolated_host_attestation "$isolated_host_attestation" \
  --arg timeout_command "$timeout_command" --argjson scaffold_timeout "$timeout_seconds" \
  --argjson timeout_kill_grace "$timeout_kill_grace_seconds" \
  --argjson maximum_agent_wall_clock "$maximum_agent_call_wall_clock_seconds" --argjson exit_code "$runner_exit" \
  --argjson probe_timeout "$probe_timeout_seconds" --argjson scaffold_invoked "$scaffold_invoked" \
  --argjson timed_out "$timed_out" --arg classification "$classification" --arg reason "$reason" \
  '{schema_version:"2.0",run_id:$run_id,started_at:$started,finished_at:$finished,
    repository:{revision:$revision,dirty:false},definition:{inputs:$inputs},
    agent:{name:$agent,version:$version,model:$model,probe_invoked:true,scaffold_invoked:$scaffold_invoked},
    environment:{os:$os,ruby:$ruby,node:$node,npm:$npm,pnpm:$pnpm,git:$git},
    security:{umask:"077",process_environment:"env -i",shell_environment_inherit:"none",
      credential_store:"file",
      auth_material_available:$auth_material_available,auth_source:$auth_source,
      stripped_sensitive_variable_categories:$stripped,
      raw_cleanup:"EXIT/INT/TERM",auth_material_persisted:false},
    network_preflight:$network,
    runner:{timeout_command:$timeout_command,scaffold_timeout_seconds:$scaffold_timeout,
      probe_timeout_seconds:$probe_timeout,timeout_kill_grace_seconds:$timeout_kill_grace,
      maximum_agent_call_wall_clock_seconds:$maximum_agent_wall_clock,
      sandbox_network_access:$sandbox_network_access,
      agent_configuration_mode:$agent_configuration_mode,
      isolated_host_attestation:$isolated_host_attestation,network_probe_artifact:"sandbox-network-probe.json",
      exit_code:$exit_code,timed_out:$timed_out,config_artifact:"invocation.json",
      execution_boundary:$execution_boundary},
    result:{classification:$classification,reason:$reason,tutorial_claims_supported:false}}' >"$evidence_dir/run.json"

checksum_files="$private_dir/checksum-files"
(cd "$evidence_dir" && find . -maxdepth 1 -type f ! -name SHA256SUMS -print | LC_ALL=C sort | sed 's#^./##') \
  >"$checksum_files"
"${minimal_env[@]}" node "$dependency_root/node_modules/prettier/bin/prettier.cjs" \
  --write --print-width 100 "$evidence_dir"/*.json >/dev/null
(cd "$evidence_dir" && while IFS= read -r file; do shasum -a 256 "$file"; done <"$checksum_files" >SHA256SUMS)
"$eval_dir/bin/validate-evidence-entries" "$evidence_dir"
if [[ "$auth_material_available" == true ]]; then
  assert_credential_absent "$evidence_dir"
fi
scan_evidence_for_sensitive_artifacts "$evidence_dir"

"$eval_dir/bin/assert-agent-call-contained" "$output"
mkdir -m 700 "$output"
cp "$evidence_dir"/* "$output/"
"$eval_dir/bin/validate-evidence-entries" "$output"
if [[ "$auth_material_available" == true ]]; then
  assert_credential_absent "$output"
fi
output_publishable=true

echo "recorded run: $output"
echo "runner exit: $runner_exit; classification: $classification"
