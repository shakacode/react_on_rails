#!/usr/bin/env bash
set -euo pipefail

agent="${1:-}"
credential_file="${2:-}"
[[ "$agent" == claude && -f "$credential_file" && ! -L "$credential_file" ]] || {
  echo "usage: canonicalize-model-credential claude CREDENTIAL_FILE" >&2
  exit 64
}

perl -e '
  use strict;
  use warnings;

  my ($path) = @ARGV;
  open my $credential_fh, "+<", $path or die "cannot open credential file\n";
  binmode $credential_fh;
  local $/;
  my $credential = <$credential_fh>;
  die "Claude model credential must contain exactly one nonempty line\n"
    unless defined($credential) && $credential =~ /\A[^\r\n]+(?:\n)?\z/;
  $credential =~ s/\n\z//;
  seek($credential_fh, 0, 0) or die "cannot rewind credential file\n";
  truncate($credential_fh, 0) or die "cannot truncate credential file\n";
  print {$credential_fh} $credential or die "cannot write credential file\n";
  close $credential_fh or die "cannot close credential file\n";
' "$credential_file" || {
  echo "Claude model credential canonicalization failed" >&2
  exit 65
}
