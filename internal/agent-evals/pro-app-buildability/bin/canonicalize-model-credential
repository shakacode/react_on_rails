#!/usr/bin/env bash
set -euo pipefail

credential_format="${1:-}"
credential_file="${2:-}"
output_file="${3:-}"

case "$credential_format" in
  claude)
    [[ -f "$credential_file" && ! -L "$credential_file" && -z "$output_file" ]] || {
      echo "usage: canonicalize-model-credential claude CREDENTIAL_FILE" >&2
      exit 64
    }
    perl -e '
      use strict;
      use warnings;

      my ($path) = @ARGV;
      open my $credential_fh, "+<", $path or die;
      binmode $credential_fh;
      local $/;
      my $credential = <$credential_fh>;
      my $control_check = $credential;
      $control_check =~ s/\n\z// if defined($control_check);
      die if defined($control_check) && $control_check =~ /[\x00-\x1f\x7f]/;
      die unless defined($credential) && $credential =~ /\A[^\r\n]+(?:\n)?\z/;
      $credential =~ s/\n\z//;
      seek($credential_fh, 0, 0) or die;
      truncate($credential_fh, 0) or die;
      print {$credential_fh} $credential or die;
      close $credential_fh or die;
    ' "$credential_file" 2>/dev/null || {
      echo "Claude model credential canonicalization failed" >&2
      exit 65
    }
    ;;
  claude-oauth)
    [[ -f "$credential_file" && ! -L "$credential_file" && -n "$output_file" && \
      ! -e "$output_file" && ! -L "$output_file" ]] || {
      echo "Claude model credential canonicalization failed" >&2
      exit 65
    }
    perl -MJSON::PP -MScalar::Util=looks_like_number \
      -MFcntl=O_CREAT,O_EXCL,O_WRONLY -MFile::Basename=dirname -e '
      use strict;
      use warnings;
      use bytes;

      my ($source, $output) = @ARGV;
      open my $source_fh, "<", $source or die;
      binmode $source_fh;
      local $/;
      my $encoded = <$source_fh>;
      close $source_fh or die;
      die unless defined($encoded) && length($encoded) >= 1 && length($encoded) <= 1_048_576;

      my $json = JSON::PP->new->allow_nonref(1)->max_depth(64)->canonical(1);
      my $decoded = $json->decode($encoded);
      die unless ref($decoded) eq "HASH";
      my %allowed_top = map { $_ => 1 } qw(claudeAiOauth mcpOAuth);
      die if grep { !$allowed_top{$_} } keys %{$decoded};
      my $oauth = $decoded->{claudeAiOauth};
      die unless ref($oauth) eq "HASH";

      my @oauth_keys = qw(
        accessToken refreshToken expiresAt refreshTokenExpiresAt scopes subscriptionType rateLimitTier
      );
      my %allowed_oauth = map { $_ => 1 } @oauth_keys;
      die if grep { !$allowed_oauth{$_} } keys %{$oauth};
      die if grep { !exists($oauth->{$_}) } @oauth_keys;

      my $is_json_string = sub {
        my ($value) = @_;
        return 0 if ref($value) || !defined($value);
        return $json->encode($value) =~ /\A"/;
      };

      for my $token_key (qw(accessToken refreshToken)) {
        my $token = $oauth->{$token_key};
        die unless $is_json_string->($token);
        die if length($token) < 8 || length($token) > 262_144;
        die if $token =~ /[\x00-\x1f\x7f]/;
      }
      for my $timestamp_key (qw(expiresAt refreshTokenExpiresAt)) {
        my $timestamp = $oauth->{$timestamp_key};
        die if ref($timestamp) || !defined($timestamp) || !looks_like_number($timestamp);
        die unless $json->encode($timestamp) =~ /\A[0-9]+\z/;
        die if $timestamp < 1 || $timestamp > 9_007_199_254_740_991;
      }
      my $scopes = $oauth->{scopes};
      die unless ref($scopes) eq "ARRAY" && @{$scopes} <= 128;
      for my $scope (@{$scopes}) {
        die unless $is_json_string->($scope);
        die if length($scope) < 1 || length($scope) > 1_024;
        die if $scope =~ /[\x00-\x1f\x7f]/;
      }
      for my $metadata_key (qw(subscriptionType rateLimitTier)) {
        my $metadata = $oauth->{$metadata_key};
        next unless defined($metadata);
        die unless $is_json_string->($metadata);
        die if length($metadata) < 1 || length($metadata) > 1_024;
        die if $metadata =~ /[\x00-\x1f\x7f]/;
      }

      my %retained = map { $_ => $oauth->{$_} } @oauth_keys;
      my $canonical = $json->encode({claudeAiOauth => \%retained});
      die if length($canonical) > 1_048_576;

      my $parent = dirname($output);
      lstat($parent) or die;
      die unless -d _ && !-l _ && ((stat($parent))[2] & 0777) == 0700;
      my $created = 0;
      eval {
        sysopen my $output_fh, $output, O_WRONLY | O_CREAT | O_EXCL, 0600 or die;
        $created = 1;
        binmode $output_fh;
        print {$output_fh} $canonical or die;
        close $output_fh or die;
        die unless ((stat($output))[2] & 0777) == 0600;
      };
      if ($@) {
        unlink($output) if $created;
        die;
      }
    ' "$credential_file" "$output_file" 2>/dev/null || {
      echo "Claude model credential canonicalization failed" >&2
      exit 65
    }
    ;;
  *)
    echo "usage: canonicalize-model-credential claude CREDENTIAL_FILE | claude-oauth SOURCE OUTPUT" >&2
    exit 64
    ;;
esac
