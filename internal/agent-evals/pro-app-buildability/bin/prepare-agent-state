#!/usr/bin/env bash
set -euo pipefail
umask 077

state_dir="${1:-}"
runner_home="${2:-}"
agent_home="${3:-}"
safe_path="${4:-}"
[[ "$state_dir" = /* && "$runner_home" = /* && "$agent_home" = /* && -n "$safe_path" && \
  "$state_dir" != *$'\n'* && "$state_dir" != *$'\r'* ]] || {
  echo "usage: $0 ABSOLUTE_STATE_DIRECTORY RUNNER_HOME AGENT_HOME SAFE_PATH" >&2
  exit 64
}
state_parent="$(dirname "$state_dir")"
[[ -d "$state_parent" ]] || { echo "agent state parent must exist" >&2; exit 65; }
state_dir="$(cd "$state_parent" && pwd -P)/$(basename "$state_dir")"
runner_home="$(realpath "$runner_home")"
agent_home="$(realpath "$agent_home")"
[[ ! -L "$state_dir" && ! -e "$state_dir" ]] || {
  echo "agent state directory must not already exist or be a symbolic link" >&2
  exit 65
}

bundle_path="$state_dir/bundle"
bundle_cache="$state_dir/bundle-cache"
npm_cache="$state_dir/npm-cache"
gem_install_dir="$state_dir/gems"
gem_bin_dir="$state_dir/gem-bin"
state_tmp="$state_dir/tmp"
mkdir -p "$bundle_path" "$bundle_cache" "$npm_cache" "$gem_install_dir" "$gem_bin_dir" "$state_tmp"
chmod 700 "$state_dir" "$bundle_path" "$bundle_cache" "$npm_cache" "$gem_install_dir" "$gem_bin_dir" "$state_tmp"

augmented_path="$safe_path:$gem_bin_dir"
configure_home() {
  local configured_home="$1"
  local bundler_runtime_path
  local gem_user_dir
  local state_env
  [[ ! -L "$configured_home" && -d "$configured_home" ]] || {
    echo "agent HOME must be a real directory" >&2
    exit 65
  }
  mkdir -p "$configured_home/.bundle"
  chmod 700 "$configured_home" "$configured_home/.bundle"
  state_env=(env -i "PATH=$safe_path" "HOME=$configured_home" "TMPDIR=$state_tmp" LANG=C LC_ALL=C SHELL=/bin/sh CODEX_EVAL=1)
  "${state_env[@]}" ruby -ryaml -e '
    File.write(
      ARGV.fetch(0),
      { "BUNDLE_PATH" => ARGV.fetch(1), "BUNDLE_CACHE_PATH" => ARGV.fetch(2) }.to_yaml,
      mode: "w",
      perm: 0o600,
    )
  ' "$configured_home/.bundle/config" "$bundle_path" "$bundle_cache"
  bundler_runtime_path="$("${state_env[@]}" ruby -rbundler -e 'print Bundler.bundle_path')"
  case "$bundler_runtime_path/" in
    "$bundle_path"/*) ;;
    *) echo "Bundler path escaped agent state" >&2; exit 65 ;;
  esac
  mkdir -p "$bundler_runtime_path"
  chmod 700 "$bundler_runtime_path"
  "${state_env[@]}" ruby -rshellwords -e '
    File.write(
      ARGV.fetch(0),
      "gem: #{["--install-dir", ARGV.fetch(1), "--bindir", ARGV.fetch(2), "--no-document"].shelljoin}\n",
      mode: "w",
      perm: 0o600,
    )
  ' "$configured_home/.gemrc" "$gem_install_dir" "$gem_bin_dir"
  "${state_env[@]}" npm config set cache "$npm_cache" --location=user

  gem_user_dir="$("${state_env[@]}" ruby -e 'require "rubygems"; print Gem.user_dir')"
  case "$gem_user_dir/" in
    "$configured_home"/*) ;;
    *) echo "RubyGems user directory escaped agent HOME" >&2; exit 65 ;;
  esac
  mkdir -p "$(dirname "$gem_user_dir")"
  ln -s "$gem_install_dir" "$gem_user_dir"
}

configure_home "$runner_home"
configure_home "$agent_home"
printf '%s\n' "$augmented_path"
