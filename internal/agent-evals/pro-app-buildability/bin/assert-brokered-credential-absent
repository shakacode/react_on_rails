#!/usr/bin/env bash
set -euo pipefail

agent="${1:-}"
credential_format="${2:-}"
scan_target="${3:-}"
current_credential="${4:-}"
symlink_policy="${5:-}"
[[ ( "$agent" == codex || "$agent" == claude ) && \
  ( "$credential_format" == native || \
    ( "$agent" == claude && "$credential_format" == claude-oauth ) ) && \
  -n "$scan_target" && -n "$current_credential" && \
  ( -z "$symlink_policy" || "$symlink_policy" == --skip-symlinks ) ]] || {
  echo "usage: $0 codex|claude native|claude-oauth DIRECTORY CURRENT_CREDENTIAL [--skip-symlinks]" >&2
  exit 64
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
credential_profile=generic
[[ "$credential_format" == claude-oauth ]] && credential_profile=claude-oauth
scan_symlink_policy="${symlink_policy:-reject}"
scan_args=("$scan_target" - "$scan_symlink_policy" "$credential_profile")
"$script_dir/assert-credential-absent" "${scan_args[@]}"

# Preserve the immutable original snapshot supplied on stdin, and additionally
# scan the current file-backed store when it survives the run. Either CLI may
# atomically rotate its store; neither generation may reach evidence.
if [[ -e "$current_credential" || -L "$current_credential" ]]; then
  [[ ! -L "$current_credential" && -f "$current_credential" ]] || {
    echo "current credential scan failed closed" >&2
    exit 2
  }
  current_scan_args=("$scan_target" "$current_credential" "$scan_symlink_policy" "$credential_profile")
  "$script_dir/assert-credential-absent" "${current_scan_args[@]}"
fi
