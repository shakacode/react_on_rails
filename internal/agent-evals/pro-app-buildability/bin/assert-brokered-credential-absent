#!/usr/bin/env bash
set -euo pipefail

agent="${1:-}"
scan_target="${2:-}"
current_credential="${3:-}"
symlink_policy="${4:-}"
[[ ( "$agent" == codex || "$agent" == claude ) && -n "$scan_target" && -n "$current_credential" && \
  ( -z "$symlink_policy" || "$symlink_policy" == --skip-symlinks ) ]] || {
  echo "usage: $0 codex|claude DIRECTORY CURRENT_CREDENTIAL [--skip-symlinks]" >&2
  exit 64
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
scan_args=("$scan_target" -)
[[ -z "$symlink_policy" ]] || scan_args+=("$symlink_policy")
"$script_dir/assert-credential-absent" "${scan_args[@]}"

# Preserve the immutable original snapshot supplied on stdin, and for Codex
# additionally scan the current file-backed store when it survives the run.
# Codex may atomically rotate auth.json; neither generation may reach evidence.
if [[ "$agent" == codex && ( -e "$current_credential" || -L "$current_credential" ) ]]; then
  [[ ! -L "$current_credential" && -f "$current_credential" ]] || {
    echo "current credential scan failed closed" >&2
    exit 2
  }
  current_scan_args=("$scan_target" "$current_credential")
  [[ -z "$symlink_policy" ]] || current_scan_args+=("$symlink_policy")
  "$script_dir/assert-credential-absent" "${current_scan_args[@]}"
fi
