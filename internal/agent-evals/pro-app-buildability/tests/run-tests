claude_spaced_marker_mismatch_output=$'EXIT:0\nRspack compiled successfully'
jq -cn --arg command "$claude_v5_build_command" --arg output "$claude_spaced_marker_mismatch_output" \
  '{type:"item.completed",item:{type:"command_execution",command:$command,exit_code:0,status:"completed",aggregated_output:$output}}' \
  >"$tmp/claude-spaced-marker-mismatch-events.jsonl"
mkdir "$tmp/claude-spaced-marker-mismatch-output"
node "$eval_dir/bin/derive-evidence.mjs" "$tmp/claude-spaced-marker-mismatch-events.jsonl" \
  "$tmp/claude-compact-build-workspace" "$tmp/claude-spaced-marker-mismatch-output" \
  "$tmp/fixture-report.json" "$tmp/fixture-invocation.json"
test "$(jq -r '.items[] | select(.id == "build.production") | .status' \
  "$tmp/claude-spaced-marker-mismatch-output/rubric-results.json")" = unknown

echo "focused harness tests passed"
