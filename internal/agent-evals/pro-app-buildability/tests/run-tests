#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
eval_dir="$root/internal/agent-evals/pro-app-buildability"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/ror-eval-tests.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT INT TERM

timeout_command="$(command -v timeout || command -v gtimeout)"
rg -Fq 'The initial public scaffold command itself must propagate generator failures' \
  "$eval_dir/prompt.md"
rg -Fq 'and preserve bounded terminal completion evidence.' \
  "$eval_dir/prompt.md"
rg -Fq 'one shell invocation with `set -o pipefail` as the exact top-level line' \
  "$eval_dir/prompt.md"
rg -Fq 'immediately before a single bounded `tee | tail` scaffold pipeline.' \
  "$eval_dir/prompt.md"
rg -Fq 'Use exactly `tail -c 4096` for this scaffold proof so its terminal completion' \
  "$eval_dir/prompt.md"
rg -Fq 'and status marker fit within the immutable command-evidence limit.' \
  "$eval_dir/prompt.md"
rg -Fq '`bash -c`, a subshell, or a background process for this proof; run it in the' \
  "$eval_dir/prompt.md"
rg -Fq 'foreground so its completed event proves the generator itself finished.' \
  "$eval_dir/prompt.md"
rg -Fq 'later generated files or manifests as a substitute for the scaffold command' \
  "$eval_dir/prompt.md"
rg -Fq 'Final test and production-build evidence must likewise preserve the target command' \
  "$eval_dir/prompt.md"
rg -Fq 'pipeline status immediately in a unique zero-status marker.' \
  "$eval_dir/prompt.md"
rg -Fq 'commands whose status could mask the test or build result.' \
  "$eval_dir/prompt.md"
rg -Fq 'The immediate-marker alternative for final test and production-build evidence may' \
  "$eval_dir/prompt.md"
rg -Fq 'omit `set -o pipefail`; the exact `PIPESTATUS[0]` assignment itself preserves the' \
  "$eval_dir/prompt.md"
rg -Fq 'target status. This alternative never applies to the initial scaffold proof.' \
  "$eval_dir/prompt.md"
for marker in ROR_EVAL_SCAFFOLD_EXIT ROR_EVAL_TEST_EXIT ROR_EVAL_BUILD_EXIT; do
  rg -Fq "${marker}=\${PIPESTATUS[0]}" "$eval_dir/prompt.md"
  rg -Fq "echo \"${marker}=\$${marker}\"" "$eval_dir/prompt.md"
done
rg -Fq 'then echo it as the final executable line in that shell invocation.' \
  "$eval_dir/prompt.md"
rg -Fq 'Prefer a bounded tail-only pipeline when no persistent log is needed.' \
  "$eval_dir/prompt.md"
rg -Fq 'If `npm run build` needs a secret, use exactly' "$eval_dir/prompt.md"
rg -Fq '`SECRET_KEY_BASE=$(bin/rails secret) npm run build` as the bounded pipeline target.' \
  "$eval_dir/prompt.md"
rg -Fq 'Do not use `SECRET_KEY_BASE_DUMMY`, a literal secret, or another command substitution.' \
  "$eval_dir/prompt.md"
rg -Fq 'Do not source a workspace or model-created shell file in a final proof invocation.' \
  "$eval_dir/prompt.md"
rg -Fq 'Complete setup in an earlier command, and express any required non-sensitive environment' \
  "$eval_dir/prompt.md"
rg -Fq 'assignments explicitly in the final proof invocation.' \
  "$eval_dir/prompt.md"
rg -Fq 'The runner PATH already includes its prepared RubyGems executable directory.' \
  "$eval_dir/prompt.md"
rg -Fq 'Do not assign or export PATH, GEM_HOME, GEM_PATH, BUNDLE_PATH, RUBYOPT, RUBYLIB,' \
  "$eval_dir/prompt.md"
rg -Fq 'NODE_OPTIONS, BASH_ENV, ENV, SHELL, or SHELLOPTS in a final proof invocation.' \
  "$eval_dir/prompt.md"
rg -Fq 'Configure passwordless local database access during earlier setup; never put PGPASSWORD' \
  "$eval_dir/prompt.md"
rg -Fq 'in a final proof invocation.' "$eval_dir/prompt.md"
rg -Fq 'If the final test proof needs database routing, first change' \
  "$eval_dir/prompt.md"
rg -Fq 'to the app directory with at most one literal `cd`, then export only PGHOST, PGPORT, and' \
  "$eval_dir/prompt.md"
rg -Fq 'PGUSER as separate literal lines in that order: use the workspace' \
  "$eval_dir/prompt.md"
rg -Fq '`.ror-eval-state/pgsocket` path, port 5433, and user `postgres`.' \
  "$eval_dir/prompt.md"
exec 9<"$eval_dir/README.md"
IFS=: read -r fixture_kind fixture_mode fixture_size \
  <<<"$("$eval_dir/bin/file-descriptor-metadata" 9)"
test "$fixture_kind" = regular
test "$fixture_mode" = "0$("$eval_dir/bin/file-permission-mode" "$eval_dir/README.md")"
test "$fixture_size" = "$(wc -c <"$eval_dir/README.md" | tr -d ' ')"
test "$(head -c 1 <&9)" = '#'
exec 9<&-
mkdir "$tmp/forced-timeout-agents"
for fake_agent in codex claude; do
  printf '%s\n' '#!/bin/sh' 'trap "" TERM' 'while :; do :; done' \
    >"$tmp/forced-timeout-agents/$fake_agent"
  chmod 700 "$tmp/forced-timeout-agents/$fake_agent"
  set +e
  "$eval_dir/bin/run-with-timeout" "$timeout_command" 1 1 \
    "$tmp/$fake_agent-forced-timeout-error" "$tmp/forced-timeout-agents/$fake_agent" \
    >"$tmp/$fake_agent-forced-timeout-output"
  forced_timeout_exit=$?
  set -e
  test "$forced_timeout_exit" = 124
  rg -Fq "timeout: sending signal KILL to command '" \
    "$tmp/$fake_agent-forced-timeout-error"
  test ! -e "$tmp/$fake_agent-forced-timeout-error.timeout"
  test ! -e "$tmp/$fake_agent-forced-timeout-error.shell"
done
printf '%s\n' '#!/bin/sh' \
  'printf "%s\n" "timeout: sending signal KILL to command '\''spoofed'\''" >&2' \
  'kill -KILL $$' >"$tmp/forced-timeout-agents/unrelated-sigkill"
chmod 700 "$tmp/forced-timeout-agents/unrelated-sigkill"
set +e
"$eval_dir/bin/run-with-timeout" "$timeout_command" 5 5 "$tmp/unrelated-sigkill-error" \
  "$tmp/forced-timeout-agents/unrelated-sigkill" >"$tmp/unrelated-sigkill-output"
unrelated_sigkill_exit=$?
set -e
test "$unrelated_sigkill_exit" = 137
rg -Fq "timeout: sending signal KILL to command 'spoofed'" "$tmp/unrelated-sigkill-error"
test ! -e "$tmp/unrelated-sigkill-error.timeout"
test ! -e "$tmp/unrelated-sigkill-error.shell"

node "$eval_dir/bin/validate-json.mjs" --schemas-only
claude_agent_report_schema="$("$eval_dir/bin/build-claude-agent-report-schema")"
jq -e 'has("$schema") | not' <<<"$claude_agent_report_schema" >/dev/null
jq -e --argjson compatible "$claude_agent_report_schema" \
  'has("$schema") and del(."$schema") == $compatible' \
  "$eval_dir/schemas/agent-report.schema.json" >/dev/null
historical_run="$eval_dir/runs/2026-07-12-codex-gpt-5.4-final21-network-off"
node "$eval_dir/bin/validate-json.mjs" "$historical_run" >/dev/null
"$eval_dir/bin/validate-run-pair" "$historical_run/run.json" \
  "$historical_run/invocation.json"
agent_configuration_run="$tmp/agent-configuration-mode"
cp -R "$historical_run" "$agent_configuration_run"
jq '.agent_configuration_mode = "codex-native"' "$historical_run/invocation.json" \
  >"$agent_configuration_run/invocation.json"
jq '.runner.agent_configuration_mode = "codex-native"' "$historical_run/run.json" \
  >"$agent_configuration_run/run.json"
node "$eval_dir/bin/validate-json.mjs" "$agent_configuration_run" >/dev/null
"$eval_dir/bin/validate-run-pair" "$agent_configuration_run/run.json" \
  "$agent_configuration_run/invocation.json"
jq 'del(.runner.agent_configuration_mode)' "$agent_configuration_run/run.json" \
  >"$tmp/missing-run-agent-configuration-mode.json"
if "$eval_dir/bin/validate-run-pair" "$tmp/missing-run-agent-configuration-mode.json" \
  "$agent_configuration_run/invocation.json" 2>"$tmp/missing-run-agent-configuration-mode-error"; then
  echo "run/invocation validator accepted a one-sided agent configuration mode" >&2
  exit 1
fi
rg -q 'run/invocation security or agent identity disagrees' \
  "$tmp/missing-run-agent-configuration-mode-error"
timeout_grace_run="$tmp/timeout-kill-grace"
cp -R "$historical_run" "$timeout_grace_run"
jq '.timeout_kill_grace_seconds = 10 |
  .maximum_agent_call_wall_clock_seconds += 20' \
  "$historical_run/invocation.json" >"$timeout_grace_run/invocation.json"
jq '.runner.timeout_kill_grace_seconds = 10 |
  .runner.maximum_agent_call_wall_clock_seconds += 20' \
  "$historical_run/run.json" >"$timeout_grace_run/run.json"
node "$eval_dir/bin/validate-json.mjs" "$timeout_grace_run" >/dev/null
"$eval_dir/bin/validate-run-pair" "$timeout_grace_run/run.json" \
  "$timeout_grace_run/invocation.json"
jq '.runner.timeout_kill_grace_seconds = 9' "$timeout_grace_run/run.json" \
  >"$tmp/mismatched-timeout-grace-run.json"
if "$eval_dir/bin/validate-run-pair" "$tmp/mismatched-timeout-grace-run.json" \
  "$timeout_grace_run/invocation.json" 2>"$tmp/mismatched-timeout-grace-error"; then
  echo "run/invocation validator accepted mismatched timeout kill grace" >&2
  exit 1
fi
rg -q 'run/invocation security or agent identity disagrees' \
  "$tmp/mismatched-timeout-grace-error"
missing_dependency_root="$tmp/missing-validator-dependencies"
set +e
EVAL_HARNESS_DEPENDENCY_ROOT="$missing_dependency_root" \
  "$eval_dir/bin/validate-run" "$historical_run" \
  >"$tmp/missing-validator-dependencies-output" \
  2>"$tmp/missing-validator-dependencies-error"
missing_dependencies_exit=$?
set -e
test "$missing_dependencies_exit" = 69
rg -Fq "pnpm --dir $missing_dependency_root install" \
  "$tmp/missing-validator-dependencies-error"
"$eval_dir/bin/validate-evidence-entries" "$historical_run"
invalid_entries_run="$tmp/invalid-evidence-entries"
cp -R "$historical_run" "$invalid_entries_run"
mkdir "$invalid_entries_run/agent-created-directory"
if "$eval_dir/bin/validate-evidence-entries" "$invalid_entries_run" \
  2>"$tmp/invalid-evidence-entries-error"; then
  echo "evidence entry validation accepted an unexpected directory" >&2
  exit 1
fi
rg -q 'evidence top-level entries mismatch' "$tmp/invalid-evidence-entries-error"

mkdir "$tmp/fake-proc" "$tmp/fake-proc/1"
: >"$tmp/fake-proc/1/status"
if EVAL_PROC_ROOT="$tmp/fake-proc" \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output" \
  2>"$tmp/inactive-proc-override-error"; then
  echo "agent containment ignored a test-only override outside test mode" >&2
  exit 1
fi
rg -q 'process overrides require explicit test mode' "$tmp/inactive-proc-override-error"
if EVAL_ISOLATED_PID_NAMESPACE=1 EVAL_PROC_ROOT="$tmp/fake-proc" EVAL_RUNNER_PID=1 \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output" \
  2>"$tmp/unauthorized-proc-override-error"; then
  echo "agent containment accepted test-only process overrides without test mode" >&2
  exit 1
fi
rg -q 'process overrides require explicit test mode' "$tmp/unauthorized-proc-override-error"
EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/fake-proc" EVAL_RUNNER_PID=1 \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output"
mkdir "$tmp/fake-proc/42"
: >"$tmp/fake-proc/42/status"
if EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/fake-proc" EVAL_RUNNER_PID=1 \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output" \
  2>"$tmp/lingering-agent-error"; then
  echo "agent containment accepted a lingering process" >&2
  exit 1
fi
rg -q 'agent process remains' "$tmp/lingering-agent-error"
rm -r "$tmp/fake-proc/42"
mkdir "$tmp/fake-proc/2"
if EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/fake-proc" EVAL_RUNNER_PID=1 \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output" \
  2>"$tmp/empty-process-dir-error"; then
  echo "agent containment accepted an empty process directory" >&2
  exit 1
fi
rg -q 'process directory is empty' "$tmp/empty-process-dir-error"
rm -r "$tmp/fake-proc/2"
mkdir "$tmp/injected-agent-output"
if "$eval_dir/bin/assert-agent-call-contained" "$tmp/injected-agent-output" \
  2>"$tmp/injected-agent-output-error"; then
  echo "agent containment accepted a pre-created output" >&2
  exit 1
fi
rg -q 'agent created the evidence output' "$tmp/injected-agent-output-error"
if "$eval_dir/bin/quiesce-agent-call" "$tmp/injected-agent-output" \
  2>"$tmp/quiesce-injected-agent-output-error"; then
  echo "agent quiescence accepted a pre-created output" >&2
  exit 1
fi
rg -q 'agent created the evidence output' "$tmp/quiesce-injected-agent-output-error"

test -x "$eval_dir/bin/quiesce-agent-call"
mkdir "$tmp/quiesce-proc" "$tmp/quiesce-proc/1" "$tmp/quiesce-proc/7" \
  "$tmp/quiesce-proc/42" "$tmp/quiesce-proc/43"
for process_id in 1 7 42 43; do
  process_parent=0
  [[ "$process_id" == 7 ]] && process_parent=1
  [[ "$process_id" == 42 ]] && process_parent=7
  [[ "$process_id" == 43 ]] && process_parent=1
  printf 'PPid:\t%s\n' "$process_parent" >"$tmp/quiesce-proc/$process_id/status"
done
printf '%s\n' active >"$tmp/quiesce-proc/42/test-kind"
printf '%s\n' exited >"$tmp/quiesce-proc/43/test-kind"
# The generated hook expands these variables when the hook runs, not while this test writes it.
# shellcheck disable=SC2016
printf '%s\n' '#!/bin/sh' 'set -eu' \
  'event=$1' 'process_id=$2' 'proc_root=$3' \
  'printf "%s %s\n" "$event" "$process_id" >>"$QUIESCE_CONTROL_LOG"' \
  'if [ "$event" = TERM ] && [ -f "$proc_root/$process_id/test-kind" ] &&' \
  '  [ "$(cat "$proc_root/$process_id/test-kind")" = active ]; then' \
  '  rm -r "$proc_root/$process_id"' \
  '  mkdir "$proc_root/45"' \
  '  printf "PPid:\t1\n" >"$proc_root/45/status"' \
  '  printf "%s\n" exited >"$proc_root/45/test-kind"' \
  'elif [ "$event" = REAP ]; then' \
  '  for process_dir in "$proc_root"/[0-9]*; do' \
  '    [ -f "$process_dir/test-kind" ] || continue' \
  '    [ "$(cat "$process_dir/test-kind")" != exited ] || rm -r "$process_dir"' \
  '  done' \
  'fi' >"$tmp/quiesce-control-hook"
chmod 700 "$tmp/quiesce-control-hook"
EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/quiesce-proc" EVAL_RUNNER_PID=7 \
  QUIESCE_CONTROL_LOG="$tmp/quiesce-control-log" \
  EVAL_PROCESS_CONTROL_HOOK="$tmp/quiesce-control-hook" \
  "$eval_dir/bin/quiesce-agent-call" "$tmp/absent-agent-output"
test ! -e "$tmp/quiesce-proc/42"
test ! -e "$tmp/quiesce-proc/43"
test ! -e "$tmp/quiesce-proc/45"
if rg -q '^(?:TERM|KILL) (?:0|1|7)$' "$tmp/quiesce-control-log"; then
  echo "agent quiescence signaled init, runner, or its own control event" >&2
  exit 1
fi
rg -Fq 'TERM 42' "$tmp/quiesce-control-log"
rg -Fq 'REAP 0' "$tmp/quiesce-control-log"
EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/quiesce-proc" EVAL_RUNNER_PID=7 \
  "$eval_dir/bin/assert-agent-call-contained" "$tmp/absent-agent-output"

mkdir "$tmp/stubborn-quiesce-proc" "$tmp/stubborn-quiesce-proc/1" \
  "$tmp/stubborn-quiesce-proc/7" "$tmp/stubborn-quiesce-proc/44"
for process_id in 1 7 44; do
  process_parent=0
  [[ "$process_id" == 7 ]] && process_parent=1
  [[ "$process_id" == 44 ]] && process_parent=7
  printf 'PPid:\t%s\n' "$process_parent" >"$tmp/stubborn-quiesce-proc/$process_id/status"
done
# The generated hook records the bounded TERM-to-KILL sequence when it runs.
# shellcheck disable=SC2016
printf '%s\n' '#!/bin/sh' 'printf "%s %s\n" "$1" "$2" >>"$STUBBORN_CONTROL_LOG"' \
  >"$tmp/stubborn-quiesce-control-hook"
chmod 700 "$tmp/stubborn-quiesce-control-hook"
if EVAL_AGENT_CONTAINMENT_TEST_MODE=1 EVAL_ISOLATED_PID_NAMESPACE=1 \
  EVAL_PROC_ROOT="$tmp/stubborn-quiesce-proc" EVAL_RUNNER_PID=7 \
  EVAL_PROCESS_CONTROL_HOOK="$tmp/stubborn-quiesce-control-hook" \
  EVAL_PROCESS_QUIESCE_DELAY=0 \
  STUBBORN_CONTROL_LOG="$tmp/stubborn-quiesce-control-log" \
  "$eval_dir/bin/quiesce-agent-call" "$tmp/absent-agent-output" \
  2>"$tmp/stubborn-quiesce-error"; then
  echo "agent quiescence accepted an unquiesceable process" >&2
  exit 1
fi
rg -q 'agent processes remain after bounded cleanup' "$tmp/stubborn-quiesce-error"
test -d "$tmp/stubborn-quiesce-proc/44"
rg -Fq 'TERM 44' "$tmp/stubborn-quiesce-control-log"
rg -Fq 'KILL 44' "$tmp/stubborn-quiesce-control-log"
if EVAL_PROCESS_CONTROL_HOOK="$tmp/quiesce-control-hook" \
  "$eval_dir/bin/quiesce-agent-call" "$tmp/absent-agent-output" \
  2>"$tmp/inactive-quiesce-hook-error"; then
  echo "agent quiescence accepted a test hook outside test mode" >&2
  exit 1
fi
rg -q 'process overrides require explicit test mode' "$tmp/inactive-quiesce-hook-error"

for boundary_case in attested-codex unattested-codex unattested-claude; do
  boundary_run="$tmp/missing-boundary-$boundary_case"
  cp -R "$historical_run" "$boundary_run"
  if [[ "$boundary_case" == attested-codex ]]; then
    jq '. + {agent:"codex"} |
      .isolated_host_attestation = true |
      .sandbox_network_access = true |
      .sandbox = "isolated-host-attested"' \
      "$boundary_run/invocation.json" >"$tmp/boundary-invocation.json"
    jq '.agent.name = "codex" |
      .runner.isolated_host_attestation = true |
      .runner.sandbox_network_access = true |
      del(.runner.execution_boundary)' \
      "$boundary_run/run.json" >"$tmp/boundary-run.json"
  elif [[ "$boundary_case" == unattested-codex ]]; then
    jq '. + {agent:"codex", auth_source:"none"} |
      .isolated_host_attestation = false |
      .sandbox_network_access = false |
      .sandbox = "workspace-write"' \
      "$boundary_run/invocation.json" >"$tmp/boundary-invocation.json"
    jq '.agent.name = "codex" |
      .security.auth_source = "none" |
      .runner.isolated_host_attestation = false |
      .runner.sandbox_network_access = false |
      del(.runner.execution_boundary)' \
      "$boundary_run/run.json" >"$tmp/boundary-run.json"
  else
    jq '. + {agent:"claude"} |
      .command = "claude -p" |
      .isolated_host_attestation = false |
      .sandbox_network_access = false |
      .sandbox = "claude-permission-gated"' \
      "$boundary_run/invocation.json" >"$tmp/boundary-invocation.json"
    jq '.agent.name = "claude" |
      .runner.isolated_host_attestation = false |
      .runner.sandbox_network_access = false |
      del(.runner.execution_boundary)' \
      "$boundary_run/run.json" >"$tmp/boundary-run.json"
  fi
  mv "$tmp/boundary-invocation.json" "$boundary_run/invocation.json"
  mv "$tmp/boundary-run.json" "$boundary_run/run.json"
  set +e
  node "$eval_dir/bin/validate-json.mjs" "$boundary_run" \
    >"$tmp/missing-boundary-$boundary_case-output" \
    2>"$tmp/missing-boundary-$boundary_case-error"
  missing_boundary_exit=$?
  set -e
  test "$missing_boundary_exit" = 1
  rg -q "must have required property 'execution_boundary'" \
    "$tmp/missing-boundary-$boundary_case-error"

  set +e
  "$eval_dir/bin/validate-run-pair" "$boundary_run/run.json" \
    "$boundary_run/invocation.json" \
    >"$tmp/missing-boundary-pair-$boundary_case-output" \
    2>"$tmp/missing-boundary-pair-$boundary_case-error"
  missing_boundary_pair_exit=$?
  set -e
  test "$missing_boundary_pair_exit" = 1
  rg -q 'run/invocation security or agent identity disagrees' \
    "$tmp/missing-boundary-pair-$boundary_case-error"
done
eval_dir_mode="$("$eval_dir/bin/file-permission-mode" "$eval_dir")"
[[ "$eval_dir_mode" =~ ^[0-7]{3,4}$ ]]

(cd "$eval_dir" && node --input-type=module - <<'NODE'
import fs from 'node:fs';
import Ajv2020 from 'ajv/dist/2020.js';
import addFormats from 'ajv-formats';

const ajv = new Ajv2020({ allErrors: true, strict: true });
addFormats(ajv);
const load = (path) => JSON.parse(fs.readFileSync(path, 'utf8'));
const invocationValidate = ajv.compile(load('schemas/invocation.schema.json'));
const runValidate = ajv.compile(load('schemas/run.schema.json'));
const fixtureDir = 'runs/2026-07-12-codex-gpt-5.4-final21-network-off';
const invocation = load(`${fixtureDir}/invocation.json`);
const nonattestedCodexInvocation = {
  ...invocation,
  agent: 'codex',
  auth_material_available: false,
  auth_source: 'none',
  isolated_host_attestation: false,
  sandbox: 'workspace-write',
};
if (!invocationValidate(nonattestedCodexInvocation)) {
  throw new Error(ajv.errorsText(invocationValidate.errors));
}
nonattestedCodexInvocation.agent_configuration_mode = 'claude-safe-mode';
if (invocationValidate(nonattestedCodexInvocation)) {
  throw new Error('Codex invocation accepted the Claude safe-mode configuration');
}
nonattestedCodexInvocation.agent_configuration_mode = 'codex-native';
if (!invocationValidate(nonattestedCodexInvocation)) {
  throw new Error(ajv.errorsText(invocationValidate.errors));
}
nonattestedCodexInvocation.sandbox = 'isolated-host-attested';
if (invocationValidate(nonattestedCodexInvocation)) {
  throw new Error('non-attested Codex invocation escaped workspace-write');
}
const legacyClaudeCommand = { ...invocation, command: 'claude -p' };
delete legacyClaudeCommand.agent;
if (invocationValidate(legacyClaudeCommand)) {
  throw new Error('legacy invocation without agent accepted a Claude command');
}
Object.assign(invocation, {
  agent: 'codex',
  auth_material_available: true,
  auth_source: 'operator-attested-file-broker',
  isolated_host_attestation: false,
});
if (invocationValidate(invocation)) throw new Error('unattested invocation accepted auth material');
invocation.isolated_host_attestation = true;
if (invocationValidate(invocation)) {
  throw new Error('attested Codex invocation claimed unavailable inner workspace sandbox');
}
invocation.sandbox = 'isolated-host-attested';
if (!invocationValidate(invocation)) throw new Error(ajv.errorsText(invocationValidate.errors));
Object.assign(invocation, { agent: 'claude', command: 'claude -p', sandbox: 'workspace-write' });
if (invocationValidate(invocation)) throw new Error('Claude invocation claimed Codex workspace sandbox');
invocation.sandbox = 'isolated-host-attested';
invocation.agent_configuration_mode = 'claude-safe-mode';
if (!invocationValidate(invocation)) throw new Error(ajv.errorsText(invocationValidate.errors));

const run = load(`${fixtureDir}/run.json`);
const nonattestedCodexRun = structuredClone(run);
Object.assign(nonattestedCodexRun.security, { auth_material_available: false, auth_source: 'none' });
