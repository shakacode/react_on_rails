)
rendered_success_regex_assertion_index=0
for success_assertion in "${rendered_success_regex_assertions[@]}"; do
  rendered_success_regex_assertion_index=$((rendered_success_regex_assertion_index + 1))
  cp -R "$tmp/rendered-form-success-workspace" \
    "$tmp/rendered-form-success-regex-$rendered_success_regex_assertion_index-workspace"
  ruby -e '
    path, assertion = ARGV
    content = File.read(path)
